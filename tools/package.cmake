cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT SOURCE_REVISION MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Pass -DSOURCE_REVISION=<full Git commit SHA> before -P")
endif()
string(LENGTH "${SOURCE_REVISION}" revision_length)
if(NOT revision_length EQUAL 40)
    message(FATAL_ERROR "SOURCE_REVISION must be a full 40-character commit SHA")
endif()
if(CMAKE_HOST_WIN32)
    set(platform windows-x86_64-msvc)
    set(runtime "Windows x64; static MSVC runtime; KERNEL32.dll")
    set(executable bin/tatr.exe)
    set(extension zip)
    set(archive_flags cf)
    set(archive_format zip)
    set(generator_args)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND EXISTS /etc/alpine-release)
    file(READ /etc/alpine-release alpine)
    if(NOT alpine MATCHES "^3[.]21[.]")
        message(FATAL_ERROR "This package recipe is verified only on Alpine 3.21")
    endif()
    set(platform linux-x86_64-alpine3.21-musl)
    set(runtime "Alpine 3.21 x64/musl; libstdc++.so.6; libgcc_s.so.1; libc.musl-x86_64.so.1")
    set(executable bin/tatr)
    set(extension tar.gz)
    set(archive_flags czf)
    set(archive_format gnutar)
    set(generator_args -G Ninja)
else()
    message(FATAL_ERROR "Packaging is verified only on Windows/MSVC and Alpine 3.21/GCC x64")
endif()
set(output "${root}/build/packages/${platform}")
set(binary "${output}/build")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${binary}" ${generator_args}
    -DCMAKE_BUILD_TYPE=MinSizeRel -DBUILD_TESTING=OFF -DTATR_STRICT=ON
    -DCMAKE_INSTALL_BINDIR=bin -DCMAKE_INSTALL_DATADIR=share
    COMMAND_ERROR_IS_FATAL ANY)
include("${binary}/tatr-build-info.cmake")
if(NOT package_processor MATCHES "^(AMD64|amd64|x86_64)$" OR NOT package_pointer_bytes EQUAL 8)
    message(FATAL_ERROR "Only native x64 packages are verified")
endif()
if(package_cross_compiling OR (CMAKE_HOST_WIN32 AND NOT package_compiler_architecture STREQUAL "x64"))
    message(FATAL_ERROR "Cross-compilation is outside the verified package recipes")
endif()
if((CMAKE_HOST_WIN32 AND NOT package_compiler MATCHES "^MSVC ") OR
   (NOT CMAKE_HOST_WIN32 AND NOT package_compiler MATCHES "^GNU "))
    message(FATAL_ERROR "Use MSVC on Windows and GCC on Alpine for these packages")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary}" --config MinSizeRel --parallel 2
    COMMAND_ERROR_IS_FATAL ANY)
set(name "tatr-${package_version}-${platform}")
# Fresh staging and extraction trees avoid stale files without recursive deletion.
string(TIMESTAMP stamp "%Y%m%d%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(run "${output}/runs/${stamp}-${nonce}")
set(stage "${run}/stage/${name}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${binary}" --config MinSizeRel
    --prefix "${stage}" COMMAND_ERROR_IS_FATAL ANY)
file(MAKE_DIRECTORY "${stage}/examples")
configure_file("${root}/tools/package-readme.md.in" "${stage}/README.md" @ONLY NEWLINE_STYLE UNIX)
configure_file("${root}/tools/package-example.toml" "${stage}/examples/tatr.toml" COPYONLY)
configure_file("${root}/tools/package-hello.cmake" "${stage}/examples/hello.cmake" COPYONLY)
file(CONFIGURE OUTPUT "${stage}/examples/.env.example"
    CONTENT "TATR_SAMPLE_VALUE=from-dotenv\n" @ONLY NEWLINE_STYLE UNIX)
set(payload "${executable}" README.md examples/tatr.toml examples/hello.cmake
    examples/.env.example share/tatr/licenses/tatr-LICENSE share/tatr/licenses/tomlc17-LICENSE)
set(manifest "{}")
foreach(key version platform compiler generator cmake runtime source_revision)
    if(key STREQUAL "version")
        set(value "${package_version}")
    elseif(key STREQUAL "compiler")
        set(value "${package_compiler}")
    elseif(key STREQUAL "generator")
        set(value "${package_generator}")
    elseif(key STREQUAL "cmake")
        set(value "${package_cmake}")
    elseif(key STREQUAL "source_revision")
        set(value "${SOURCE_REVISION}")
    else()
        set(value "${${key}}")
    endif()
    string(JSON manifest SET "${manifest}" "${key}" "\"${value}\"")
endforeach()
string(JSON manifest SET "${manifest}" files "{}")
foreach(path IN LISTS payload)
    file(SHA256 "${stage}/${path}" digest)
    string(JSON manifest SET "${manifest}" files "${path}" "\"${digest}\"")
endforeach()
file(CONFIGURE OUTPUT "${stage}/MANIFEST.json" CONTENT "${manifest}\n" @ONLY NEWLINE_STYLE UNIX)
list(APPEND payload MANIFEST.json)
file(GLOB_RECURSE staged LIST_DIRECTORIES false RELATIVE "${stage}" "${stage}/*")
list(SORT payload)
list(SORT staged)
if(NOT staged STREQUAL payload)
    message(FATAL_ERROR "Unexpected or missing staged files: ${staged}")
endif()
set(archive "${output}/${name}.${extension}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar "${archive_flags}" "${archive}"
    "--format=${archive_format}" "${name}" WORKING_DIRECTORY "${run}/stage"
    COMMAND_ERROR_IS_FATAL ANY)
set(extracted "${run}/extract with spaces")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extracted}")
set(package "${extracted}/${name}")
file(GLOB_RECURSE actual LIST_DIRECTORIES false RELATIVE "${package}" "${package}/*")
list(SORT actual)
if(NOT actual STREQUAL payload)
    message(FATAL_ERROR "Unexpected or missing archive files: ${actual}")
endif()
foreach(path IN LISTS payload)
    file(SHA256 "${stage}/${path}" before)
    file(SHA256 "${package}/${path}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Extraction changed ${path}")
    endif()
endforeach()
# Launch from outside the package: --file, cwd, dotenv and file logging are exercised.
foreach(option --help --version)
    execute_process(COMMAND "${package}/${executable}" "${option}" WORKING_DIRECTORY "${run}"
        OUTPUT_VARIABLE text COMMAND_ERROR_IS_FATAL ANY)
    if(option STREQUAL "--version" AND NOT text STREQUAL "tatr ${package_version}\n")
        message(FATAL_ERROR "Packaged executable version mismatch: ${text}")
    endif()
endforeach()
foreach(command list plan run)
    set(target hello)
    if(command STREQUAL "list")
        set(target)
    endif()
    execute_process(COMMAND "${package}/${executable}" --file "${package}/examples/tatr.toml"
        "${command}" ${target} WORKING_DIRECTORY "${run}"
        OUTPUT_VARIABLE child_output ERROR_VARIABLE records COMMAND_ERROR_IS_FATAL ANY)
    if(NOT command STREQUAL "run" AND EXISTS "${package}/logs")
        message(FATAL_ERROR "Read-only commands created package logs")
    endif()
endforeach()
file(GLOB logs "${package}/logs/*.log")
list(LENGTH logs log_count)
if(NOT log_count EQUAL 1 OR NOT child_output MATCHES "dotenv loaded successfully")
    message(FATAL_ERROR "Package sample did not verify dotenv/file logging")
endif()
list(GET logs 0 logfile)
file(READ "${logfile}" file_records)
if(NOT file_records STREQUAL records OR NOT records MATCHES "outcome=success" OR
   file_records MATCHES "dotenv loaded successfully|from-dotenv")
    message(FATAL_ERROR "Console/file records differ or include child/environment output")
endif()
file(SHA256 "${archive}" archive_digest)
file(CONFIGURE OUTPUT "${output}/${name}.sha256"
    CONTENT "${archive_digest}  ${name}.${extension}\n" @ONLY NEWLINE_STYLE UNIX)
message(STATUS "Verified package: ${archive}")
message(STATUS "SHA256: ${archive_digest}")
