cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(config "${TEST_ROOT}/tatr.toml")
set(log "${TEST_ROOT}/executed.log")
# Remove only this fixture's output so repeat runs cannot hide side effects.
file(REMOVE "${log}")
set(source "version = 1\n")
set(arguments run target)
set(expected_code 0)
set(expected_output "")
set(expected_error "")
set(expected_log "")
set(input "${TEST_ROOT}/stdin.txt")
file(WRITE "${input}" "input text\n")

function(task name command)
    string(APPEND source "[tasks.${name}]\nexec = [${command}]\n")
    set(source "${source}" PARENT_SCOPE)
endfunction()

if(CASE STREQUAL "arguments")
    task(target [=["PLACEHOLDER", "args", "", "plain", "two words", "a\"b", "\\", "tail\\", "a\\\"b", "a\\\\\"b", "测试 café", "tab\tline\n", "semi;colon", "'single'", "\"\"", "space tail\\", "two tails \\\\", ""]=])
    string(REPLACE PLACEHOLDER "${CHILD}" source "${source}")
    set(expected_output "[]\n[706c61696e]\n[74776f20776f726473]\n[612262]\n[5c]\n[7461696c5c]\n[615c2262]\n[615c5c2262]\n[e6b58be8af9520636166c3a9]\n[746162096c696e650a]\n[73656d693b636f6c6f6e]\n[2773696e676c6527]\n[2222]\n[7370616365207461696c5c]\n[74776f207461696c73205c5c]\n[]\n")
elseif(CASE STREQUAL "inherited_io")
    task(target "\"${CHILD}\", \"io\"")
    set(expected_output "stdout:input text\n")
    set(expected_error "stderr:input text\n")
elseif(CASE STREQUAL "inherited_cwd")
    file(MAKE_DIRECTORY "${TEST_ROOT}/configuration")
    set(config "${TEST_ROOT}/configuration/tatr.toml")
    set(arguments --file "${config}" run target)
    task(target "\"${CHILD}\", \"cwd\"")
    set(expected_output "${TEST_ROOT}\n")
elseif(CASE STREQUAL "inherited_env")
    set(ENV{TATR_TEST_INHERITED} "value with spaces")
    task(target "\"${CHILD}\", \"env\"")
    set(expected_output "value with spaces\n")
elseif(CASE MATCHES "^(path_lookup|relative_executable|unicode_executable)$")
    set(probe_directory "${TEST_ROOT}/工具 with spaces")
    file(MAKE_DIRECTORY "${probe_directory}")
    if(WIN32)
        set(suffix .exe)
    else()
        set(suffix "")
    endif()
    set(probe "${probe_directory}/tatr-child-probe${suffix}")
    file(COPY_FILE "${CHILD}" "${probe}" ONLY_IF_DIFFERENT)
    if(UNIX)
        file(CHMOD "${probe}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
    if(CASE STREQUAL "path_lookup")
        if(WIN32)
            set(ENV{PATH} "${probe_directory};$ENV{PATH}")
        else()
            set(ENV{PATH} "${probe_directory}:$ENV{PATH}")
        endif()
        set(executable "tatr-child-probe")
    elseif(CASE STREQUAL "relative_executable")
        set(executable "./工具 with spaces/tatr-child-probe${suffix}")
    else()
        set(executable "${probe}")
    endif()
    task(target "\"${executable}\", \"args\", \"ok\"")
    set(expected_output "[6f6b]\n")
elseif(CASE STREQUAL "ordering" OR CASE STREQUAL "grouping")
    task(target "\"${CHILD}\", \"record\", \"${log}\", \"target\"")
    if(CASE STREQUAL "grouping")
        set(source "version = 1\n[tasks.target]\n")
        set(expected_log "shared\nzeta\nalpha\n")
    else()
        set(expected_log "shared\nzeta\nalpha\ntarget\n")
    endif()
    string(APPEND source "depends = [\"zeta\", \"alpha\"]\n")
    task(zeta "\"${CHILD}\", \"record\", \"${log}\", \"zeta\"")
    string(APPEND source "depends = [\"shared\"]\n")
    task(alpha "\"${CHILD}\", \"record\", \"${log}\", \"alpha\"")
    string(APPEND source "depends = [\"shared\"]\n")
    task(shared "\"${CHILD}\", \"record\", \"${log}\", \"shared\"")
    task(unrelated "\"${CHILD}\", \"record\", \"${log}\", \"unrelated\"")
elseif(CASE STREQUAL "empty_group")
    string(APPEND source "[tasks.target]\n")
elseif(CASE MATCHES "^(stop_failure|spawn_failure|invalid_executable|exit_two|signal_failure|windows_large_status)$")
    task(target "\"${CHILD}\", \"record\", \"${log}\", \"target\"")
    string(APPEND source "depends = [\"before\", \"failure\", \"after\"]\n")
    task(before "\"${CHILD}\", \"record\", \"${log}\", \"before\"")
    set(expected_log "before\n")
    set(expected_code 1)
    set(status 7)
    if(CASE STREQUAL "exit_two")
        set(status 2)
    elseif(CASE STREQUAL "windows_large_status")
        set(status 3221225477)
    endif()
    if(CASE STREQUAL "spawn_failure")
        task(failure "\"${TEST_ROOT}/does-not-exist\"")
        set(expected_code 2)
        set(expected_error "task 'failure': cannot launch process")
    elseif(CASE STREQUAL "invalid_executable")
        file(WRITE "${TEST_ROOT}/invalid.exe" "not an executable\n")
        task(failure "\"${TEST_ROOT}/invalid.exe\"")
        set(expected_code 2)
        set(expected_error "task 'failure': cannot launch process")
    elseif(CASE STREQUAL "signal_failure")
        task(failure "\"${CHILD}\", \"signal\"")
        set(expected_error "task 'failure': terminated by signal 15")
    else()
        task(failure "\"${CHILD}\", \"exit\", \"${status}\"")
        set(expected_error "task 'failure': exited with status ${status}")
    endif()
    task(after "\"${CHILD}\", \"record\", \"${log}\", \"after\"")
elseif(CASE STREQUAL "no_shell_expansion")
    task(target [=["PLACEHOLDER", "args", "$HOME", "*", "a|b", "x>y", "%PATH%", "$(echo hi)"]=])
    string(REPLACE PLACEHOLDER "${CHILD}" source "${source}")
    set(expected_output "[24484f4d45]\n[2a]\n[617c62]\n[783e79]\n[255041544825]\n[24286563686f20686929]\n")
elseif(CASE STREQUAL "explicit_interpreter")
    if(WIN32)
        task(target [=["cmd.exe", "/d", "/c", "echo", "explicit-shell"]=])
    else()
        task(target [=["/bin/sh", "-c", "printf 'explicit-shell\n'"]=])
    endif()
    set(expected_output "explicit-shell\n")
elseif(CASE STREQUAL "no_implicit_shell")
    if(WIN32)
        set(script "${TEST_ROOT}/script.cmd")
        file(WRITE "${script}" "@echo should-not-run\n")
    else()
        set(script "${TEST_ROOT}/script")
        file(WRITE "${script}" "echo should-not-run\n")
        file(CHMOD "${script}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    endif()
    task(target "\"${script}\"")
    set(expected_code 2)
    set(expected_error "task 'target': cannot launch process")
else()
    task(target "\"${CHILD}\", \"record\", \"${log}\", \"target\"")
    set(expected_code 2)
    if(CASE STREQUAL "file_selection")
        set(config "${TEST_ROOT}/配置 with spaces.toml")
        set(arguments run target --file "${config}")
        set(expected_code 0)
        set(expected_log "target\n")
    elseif(CASE STREQUAL "unknown_target")
        set(arguments run absent)
        set(expected_error "unknown task 'absent'")
    elseif(CASE STREQUAL "missing_target" OR CASE STREQUAL "empty_target")
        set(arguments run)
        set(expected_error "run requires a task name")
    elseif(CASE STREQUAL "extra_target")
        set(arguments run target extra)
        set(expected_error "unexpected argument 'extra'")
    elseif(CASE STREQUAL "list_readonly" OR CASE STREQUAL "plan_readonly")
        set(expected_code 0)
        set(expected_output "target\n")
        if(CASE STREQUAL "list_readonly")
            set(arguments list)
        else()
            set(arguments plan target)
        endif()
    elseif(CASE STREQUAL "invalid_unrelated")
        string(APPEND source "[tasks.zzinvalid]\nexec = []\n")
        set(expected_error "task 'zzinvalid'.exec: expected a nonempty array")
    elseif(CASE STREQUAL "missing_dependency")
        string(APPEND source "depends = [\"absent\"]\n")
        set(expected_error "missing dependency 'absent'")
    elseif(CASE STREQUAL "cycle")
        string(APPEND source "depends = [\"target\"]\n")
        set(expected_error "dependency cycle: 'target' -> 'target'")
    elseif(CASE MATCHES "^exec_")
        set(source "version = 1\n")
        set(exec "[]")
        set(expected_error "expected a nonempty array of argument strings")
        if(CASE STREQUAL "exec_type")
            set(exec "\"echo\"")
        elseif(CASE STREQUAL "exec_item_type")
            set(exec "[42]")
            set(expected_error "expected an argument string")
        elseif(CASE STREQUAL "exec_mixed")
            set(exec "[\"${CHILD}\", true]")
            set(expected_error "expected an argument string")
        elseif(CASE STREQUAL "exec_empty_name")
            set(exec "[\"\"]")
            set(expected_error "executable name must be nonempty")
        elseif(CASE STREQUAL "exec_nul_name")
            set(exec [=[ ["bad\u0000name"] ]=])
            set(expected_error "NUL characters are not allowed")
        elseif(CASE STREQUAL "exec_nul_arg")
            set(exec "[\"${CHILD}\", \"bad\\u0000arg\"]")
            set(expected_error "NUL characters are not allowed")
        elseif(NOT CASE STREQUAL "exec_empty")
            message(FATAL_ERROR "Unknown exec case ${CASE}")
        endif()
        string(APPEND source "[tasks.target]\nexec = ${exec}\n")
    elseif(CASE STREQUAL "windows_command_limit")
        string(REPEAT x 33000 long_argument)
        set(source "version = 1\n")
        task(target "\"${CHILD}\", \"args\", \"${long_argument}\"")
        set(expected_error "command line exceeds Windows size limit")
    else()
        message(FATAL_ERROR "Unknown execution case ${CASE}")
    endif()
endif()

file(WRITE "${config}" "${source}")
if(CASE STREQUAL "empty_target")
    execute_process(COMMAND "${TATR}" run "" WORKING_DIRECTORY "${TEST_ROOT}"
        INPUT_FILE "${input}" RESULT_VARIABLE code OUTPUT_VARIABLE output
        ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
else()
    execute_process(COMMAND "${TATR}" ${arguments} WORKING_DIRECTORY "${TEST_ROOT}"
        INPUT_FILE "${input}" RESULT_VARIABLE code OUTPUT_VARIABLE output
        ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
assert_no_sanitizer_diagnostic("${output}" "${error}")
if(CASE STREQUAL "inherited_cwd")
    string(REPLACE "\\" "/" output "${output}")
endif()
if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "${CASE}: expected exit ${expected_code}, got ${code}\n${output}\n${error}")
endif()
if(NOT output STREQUAL expected_output)
    message(FATAL_ERROR "${CASE}: expected stdout [${expected_output}], got [${output}]")
endif()
if(expected_code EQUAL 0)
    if(NOT error STREQUAL expected_error)
        message(FATAL_ERROR "${CASE}: expected stderr [${expected_error}], got [${error}]")
    endif()
else()
    string(FIND "${error}" "${expected_error}" found)
    if(found EQUAL -1 OR NOT error MATCHES "^tatr: ")
        message(FATAL_ERROR "${CASE}: expected diagnostic [${expected_error}], got [${error}]")
    endif()
endif()
if(expected_log STREQUAL "")
    if(EXISTS "${log}")
        message(FATAL_ERROR "${CASE}: child unexpectedly created execution log")
    endif()
else()
    if(NOT EXISTS "${log}")
        message(FATAL_ERROR "${CASE}: execution log missing")
    endif()
    file(READ "${log}" actual_log)
    string(REPLACE "\r\n" "\n" actual_log "${actual_log}")
    if(NOT actual_log STREQUAL expected_log)
        message(FATAL_ERROR "${CASE}: expected log [${expected_log}], got [${actual_log}]")
    endif()
endif()
