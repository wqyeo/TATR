cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
file(MAKE_DIRECTORY "${TEST_ROOT}/config" "${TEST_ROOT}/caller" "${TEST_ROOT}/work")
set(config "${TEST_ROOT}/config/tatr.toml")
set(caller "${TEST_ROOT}/caller")
set(work "${TEST_ROOT}/work")
set(log "${TEST_ROOT}/ran.log")
file(REMOVE "${log}")
set(command "'${CHILD}', 'cwd'")
set(cwd "'../work'")
set(before "")
set(after "")
set(extra "")
set(arguments --file "${config}" run target)
set(expected_code 0)
set(expected_output "${work}\n")
set(expected_error "")
set(expected_log "")

if(CASE STREQUAL "relative")
    # Defaults establish different caller and config directories.
elseif(CASE STREQUAL "absolute" OR CASE STREQUAL "absolute_executable")
    set(cwd "'${work}'")
elseif(CASE STREQUAL "dot")
    set(cwd "'.'")
    set(expected_output "${TEST_ROOT}/config\n")
elseif(CASE STREQUAL "unicode")
    set(work "${TEST_ROOT}/工具 café with spaces")
    file(MAKE_DIRECTORY "${work}")
    set(cwd "'../工具 café with spaces'")
    set(expected_output "${work}\n")
elseif(CASE STREQUAL "relative_file")
    set(arguments --file ../config/tatr.toml run target)
elseif(CASE STREQUAL "independent")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'cwd']\ncwd = '../config'\n")
    set(after "depends = ['before']\n")
    set(expected_output "${TEST_ROOT}/config\n${work}\n")
elseif(CASE STREQUAL "parent_unchanged")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'cwd']\ncwd = '../work'\n")
    set(after "depends = ['before']\n")
    set(cwd "")
    set(expected_output "${work}\n${caller}\n")
elseif(CASE STREQUAL "prerequisite_created")
    # A fresh fixture directory ensures repeated runs still verify creation.
    string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 unique)
    set(work "${TEST_ROOT}/created-${unique}")
    set(cwd "'${work}'")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'mkdir', '${work}']\n")
    set(after "depends = ['before']\n")
    set(expected_output "${work}\n")
elseif(CASE MATCHES "^(missing|not_directory|launch_failure|child_failure)$")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'record', '${log}', 'before']\n")
    set(after "depends = ['before']\n")
    set(extra "[tasks.later]\nexec = ['${CHILD}', 'record', '${log}', 'later']\ndepends = ['target']\n")
    set(arguments --file "${config}" run later)
    set(expected_log "before\n")
    set(expected_output "")
    set(expected_code 2)
    set(expected_error "task 'target' (cwd '")
    if(CASE STREQUAL "missing")
        set(cwd "'${TEST_ROOT}/absent'")
    elseif(CASE STREQUAL "not_directory")
        file(WRITE "${TEST_ROOT}/file" "not a directory")
        set(cwd "'${TEST_ROOT}/file'")
    elseif(CASE STREQUAL "launch_failure")
        set(command "'./does-not-exist'")
    else()
        set(command "'${CHILD}', 'exit', '7'")
        set(expected_code 1)
        set(expected_error "task 'target': exited with status 7")
    endif()
elseif(CASE MATCHES "^(relative_executable|path_absolute|path_relative|path_empty_entry|path_missing|drive_relative_path)$")
    if(WIN32)
        set(suffix .exe)
        set(separator ";")
    else()
        set(suffix "")
        set(separator ":")
    endif()
    file(MAKE_DIRECTORY "${work}/bin")
    set(probe "${work}/bin/cwd-probe${suffix}")
    file(COPY_FILE "${CHILD}" "${probe}" ONLY_IF_DIFFERENT)
    if(UNIX)
        file(CHMOD "${probe}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    endif()
    set(command "'cwd-probe', 'cwd'")
    if(CASE STREQUAL "relative_executable")
        set(command "'./bin/cwd-probe${suffix}', 'cwd'")
    elseif(CASE STREQUAL "path_absolute")
        set(ENV{PATH} "${work}/bin")
    elseif(CASE STREQUAL "path_relative")
        set(ENV{PATH} "bin")
    elseif(CASE STREQUAL "path_empty_entry")
        file(COPY_FILE "${probe}" "${work}/cwd-probe${suffix}" ONLY_IF_DIFFERENT)
        if(UNIX)
            file(CHMOD "${work}/cwd-probe${suffix}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        endif()
        set(ENV{PATH} "${separator}${work}/absent")
    elseif(CASE STREQUAL "drive_relative_path")
        set(ENV{PATH} "C:bin")
        set(expected_code 2)
        set(expected_output "")
        set(expected_error "drive-relative PATH entries")
    else()
        # A matching binary in the caller must not satisfy a child's relative PATH.
        file(COPY_FILE "${probe}" "${caller}/cwd-probe${suffix}" ONLY_IF_DIFFERENT)
        set(ENV{PATH} "${work}/absent")
        set(expected_code 2)
        set(expected_output "")
        set(expected_error "cannot launch process")
    endif()
elseif(CASE STREQUAL "list_missing" OR CASE STREQUAL "plan_missing" OR CASE STREQUAL "unrelated_missing")
    set(cwd "'${TEST_ROOT}/absent'")
    set(command "'${CHILD}', 'record', '${log}', 'target'")
    set(expected_output "target\n")
    if(CASE STREQUAL "list_missing")
        set(arguments --file "${config}" list)
    elseif(CASE STREQUAL "plan_missing")
        set(arguments --file "${config}" plan target)
    else()
        set(extra "[tasks.safe]\n")
        set(arguments --file "${config}" run safe)
        set(expected_output "")
    endif()
elseif(CASE STREQUAL "symlink_parent")
    file(MAKE_DIRECTORY "${TEST_ROOT}/actual/nested")
    set(link "${work}/link")
    if(NOT EXISTS "${link}")
        file(CREATE_LINK "${TEST_ROOT}/actual/nested" "${link}" SYMBOLIC)
    endif()
    set(cwd "'../work/link/..'")
    set(expected_output "${TEST_ROOT}/actual\n")
else()
    set(command "'${CHILD}', 'record', '${log}', 'target'")
    set(expected_code 2)
    set(expected_output "")
    set(expected_error "task 'target'.cwd:")
    if(CASE STREQUAL "empty")
        set(cwd "''")
    elseif(CASE STREQUAL "type_integer")
        set(cwd "1")
    elseif(CASE STREQUAL "type_array")
        set(cwd "[]")
    elseif(CASE STREQUAL "type_boolean")
        set(cwd "true")
    elseif(CASE STREQUAL "nul_path")
        set(cwd [=["bad\u0000path"]=])
    elseif(CASE STREQUAL "grouping")
        set(command "")
        set(expected_error "requires an executable task")
    elseif(CASE STREQUAL "invalid_unrelated")
        set(extra "[tasks.invalid]\nexec = ['${CHILD}']\ncwd = 42\n")
        set(expected_error "task 'invalid'.cwd:")
    elseif(CASE STREQUAL "drive_relative")
        set(cwd "'C:work'")
        set(expected_error "drive-relative paths")
    elseif(CASE STREQUAL "drive_relative_executable")
        set(command "'C:child.exe'")
        set(expected_error "drive-relative executable paths")
    else()
        message(FATAL_ERROR "Unknown cwd fixture: ${CASE}")
    endif()
endif()

set(source "version = 1\n${before}[tasks.target]\n")
if(NOT command STREQUAL "")
    string(APPEND source "exec = [${command}]\n")
endif()
if(NOT cwd STREQUAL "")
    string(APPEND source "cwd = ${cwd}\n")
endif()
string(APPEND source "${after}${extra}")
file(WRITE "${config}" "${source}")
execute_process(COMMAND "${TATR}" ${arguments} WORKING_DIRECTORY "${caller}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
assert_no_sanitizer_diagnostic("${output}" "${error}")
string(REPLACE "\\" "/" output "${output}")
if(NOT "${code}" STREQUAL "${expected_code}" OR NOT output STREQUAL expected_output)
    message(FATAL_ERROR "${CASE}: expected ${expected_code} [${expected_output}], got ${code} [${output}] ${error}")
endif()
if(expected_code EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "${CASE}: unexpected stderr: ${error}")
    endif()
elseif(NOT error MATCHES "^tatr: ")
    message(FATAL_ERROR "${CASE}: missing diagnostic: ${error}")
else()
    string(FIND "${error}" "${expected_error}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${CASE}: expected [${expected_error}] in ${error}")
    endif()
endif()
if(EXISTS "${log}")
    file(READ "${log}" actual_log)
    string(REPLACE "\r\n" "\n" actual_log "${actual_log}")
    if(NOT actual_log STREQUAL expected_log)
        message(FATAL_ERROR "${CASE}: unexpected side effects: ${actual_log}")
    endif()
elseif(NOT expected_log STREQUAL "")
    message(FATAL_ERROR "${CASE}: prerequisite did not execute")
endif()
