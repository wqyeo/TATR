cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_ROOT}/work space")
set(config "${TEST_ROOT}/tatr.toml")
set(marker "${TEST_ROOT}/marker.txt")
set(context_file "${TEST_ROOT}/context.txt")
file(REMOVE "${marker}" "${context_file}")
set(source "version = 1\n[tasks.target]\nexec = [\"${CHILD}\", \"exit\", \"0\"]\n[tasks.other]\n")
set(code 0)
set(expected "hook\n")
set(args run target)
set(extra "")
set(trigger always)
set(hook_exec "[\"${CHILD}\", \"record\", \"${marker}\", \"hook\"]")
if(CASE MATCHES "^(failure|runner|cwd|dotenv|signal|original|preserve_runner)$")
    if(CASE MATCHES "^(failure|original)$")
        string(REPLACE "\"exit\", \"0\"" "\"exit\", \"7\"" source "${source}")
        set(code 1)
    elseif(CASE STREQUAL "signal")
        string(REPLACE "\"exit\", \"0\"" "\"signal\"" source "${source}")
        set(code 1)
    else()
        set(code 2)
        if(CASE STREQUAL "cwd")
            string(REPLACE "[tasks.other]" "cwd = \"missing directory\"\n[tasks.other]" source "${source}")
        elseif(CASE STREQUAL "dotenv")
            string(REPLACE "[tasks.other]" "env_file = \"missing.env\"\n[tasks.other]" source "${source}")
        else()
            string(REPLACE "${CHILD}" "tatr-does-not-exist" source "${source}")
        endif()
    endif()
    set(trigger failure)
elseif(CASE STREQUAL "success")
    set(trigger success)
elseif(CASE STREQUAL "skip_failure")
    set(trigger failure)
    set(expected "")
elseif(CASE STREQUAL "skip_success")
    string(REPLACE "\"exit\", \"0\"" "\"exit\", \"7\"" source "${source}")
    set(trigger success)
    set(code 1)
    set(expected "")
elseif(CASE STREQUAL "group")
    set(args run other)
elseif(CASE STREQUAL "shared")
    string(APPEND source "depends = [\"target\"]\n[tasks.final]\ndepends = [\"target\", \"other\"]\n")
    set(args run final)
elseif(CASE STREQUAL "filter_skip")
    set(extra "targets = [\"other\"]\n")
    set(expected "")
elseif(CASE STREQUAL "filter_match")
    set(extra "targets = [\"target\"]\n")
elseif(CASE STREQUAL "filter_prerequisite")
    string(APPEND source "depends = [\"target\"]\n")
    set(args run other)
    set(extra "targets = [\"target\"]\n")
    set(expected "")
elseif(CASE STREQUAL "arguments")
    string(REPLACE "\"exit\", \"0\"" "\"args\"" source "${source}")
    set(args run target -- extra)
elseif(CASE MATCHES "^(context|context_file|hook_cwd|hook_env)$")
    set(hook_exec "[\"${CHILD}\", \"hook_context\", \"${context_file}\"]")
    set(expected "")
    set(ENV{TATR_TARGET} "inherited-wrong")
    file(WRITE "${TEST_ROOT}/values.env" "TATR_TARGET=file-wrong\nTATR_HOOK_CUSTOM=from-file\n")
    set(extra "env = { TATR_TARGET = \"inline-wrong\", TATR_HOOK_CUSTOM = \"inline-secret\" }\n")
    if(CASE STREQUAL "context_file")
        set(extra "env_file = \"values.env\"\n")
    elseif(CASE STREQUAL "hook_env")
        string(APPEND extra "env_file = \"values.env\"\n")
    elseif(CASE STREQUAL "hook_cwd")
        set(hook_exec "[\"${CHILD}\", \"record\", \"relative.txt\", \"cwd\"]")
        string(APPEND extra "cwd = \"work space\"\n")
        file(REMOVE "${TEST_ROOT}/work space/relative.txt")
    endif()
elseif(CASE MATCHES "^(warn|fail|hook_launch|hook_dotenv|hook_missing_cwd|precedence|off|error_level)$")
    set(hook_exec "[\"${CHILD}\", \"exit\", \"9\"]")
    set(expected "")
    if(CASE MATCHES "^(fail|precedence)$")
        set(extra "on_error = \"fail\"\n")
        set(code 1)
    elseif(CASE MATCHES "^(hook_launch|hook_dotenv|hook_missing_cwd)$")
        set(extra "on_error = \"fail\"\n")
        set(code 2)
        if(CASE STREQUAL "hook_launch")
            set(hook_exec "[\"tatr-hook-does-not-exist\"]")
        elseif(CASE STREQUAL "hook_dotenv")
            string(APPEND extra "env_file = \"missing.env\"\n")
        else()
            string(APPEND extra "cwd = \"missing\"\n")
        endif()
    elseif(CASE STREQUAL "off")
        string(APPEND source "[logging]\nlevel = \"off\"\n")
    elseif(CASE STREQUAL "error_level")
        string(APPEND source "[logging]\nlevel = \"error\"\n")
    endif()
endif()
string(APPEND source "[[hooks]]\nname = \"notice\"\nwhen = \"${trigger}\"\nexec = ${hook_exec}\n${extra}")
if(CASE MATCHES "^(order|warn|fail|original|preserve_runner|precedence)$")
    if(CASE MATCHES "^(original|preserve_runner)$")
        string(REPLACE "exec = ${hook_exec}" "exec = [\"tatr-hook-does-not-exist\"]\non_error = \"fail\"" source "${source}")
        set(expected "")
    endif()
    string(APPEND source "[[hooks]]\nname = \"second\"\nwhen = \"success\"\nexec = [\"${CHILD}\", \"record\", \"${marker}\", \"second\"]\n")
    if(NOT CASE MATCHES "^(original|preserve_runner)$")
        string(APPEND expected "second\n")
    endif()
    string(APPEND source "[[hooks]]\nname = \"last\"\nwhen = \"always\"\nexec = [\"${CHILD}\", \"record\", \"${marker}\", \"last\"]\n")
    string(APPEND expected "last\n")
    if(CASE STREQUAL "precedence")
        string(APPEND source "[[hooks]]\nname = \"launch\"\nwhen = \"always\"\nexec = [\"tatr-hook-does-not-exist\"]\non_error = \"fail\"\n")
        set(code 2)
    endif()
elseif(CASE MATCHES "^(list|plan|unknown_target|group_args|invalid_graph|logger_open)$")
    # Neither read-only operation opens hook dotenv files.
    string(APPEND source "env_file = \"missing.env\"\n")
    set(expected "")
    if(CASE STREQUAL "list")
        set(args list)
    elseif(CASE STREQUAL "plan")
        set(args plan target)
    else()
        set(code 2)
        if(CASE STREQUAL "unknown_target")
            set(args run absent)
        elseif(CASE STREQUAL "group_args")
            set(args run other -- x)
        elseif(CASE STREQUAL "invalid_graph")
            string(APPEND source "[tasks.broken]\ndepends = [\"absent\"]\n")
        else()
            file(WRITE "${TEST_ROOT}/not-directory" "file")
            string(APPEND source "[logging.file]\ndirectory = \"not-directory/logs\"\n")
        endif()
    endif()
elseif(CASE MATCHES "^invalid_")
    set(code 2)
    set(expected "")
    if(CASE STREQUAL "invalid_name")
        string(REPLACE "name = \"notice\"" "name = \"\"" source "${source}")
    elseif(CASE STREQUAL "invalid_control")
        string(REPLACE "name = \"notice\"" "name = \"a\\n\"" source "${source}")
    elseif(CASE STREQUAL "invalid_when")
        string(REPLACE "when = \"always\"" "when = \"bad\"" source "${source}")
    elseif(CASE STREQUAL "invalid_missing_when")
        string(REPLACE "when = \"always\"" "" source "${source}")
    elseif(CASE STREQUAL "invalid_policy")
        string(APPEND source "on_error = 1\n")
    elseif(CASE STREQUAL "invalid_targets")
        string(APPEND source "targets = []\n")
    elseif(CASE STREQUAL "invalid_target")
        string(APPEND source "targets = [\"absent\"]\n")
    elseif(CASE STREQUAL "invalid_duplicate_target")
        string(APPEND source "targets = [\"target\", \"target\"]\n")
    elseif(CASE STREQUAL "invalid_exec")
        string(REPLACE "exec = ${hook_exec}" "exec = []" source "${source}")
    elseif(CASE STREQUAL "invalid_missing_exec")
        string(REPLACE "exec = ${hook_exec}" "" source "${source}")
    elseif(CASE STREQUAL "invalid_env")
        string(APPEND source "env = { SECRET = 1 }\n")
    elseif(CASE STREQUAL "invalid_field")
        string(APPEND source "depends = [\"target\"]\n")
    elseif(CASE STREQUAL "invalid_type")
        string(REPLACE "[[hooks]]" "[hooks]" source "${source}")
    elseif(CASE STREQUAL "invalid_duplicate")
        string(APPEND source "[[hooks]]\nname = \"notice\"\nwhen = \"always\"\nexec = [\"x\"]\n")
    else()
        message(FATAL_ERROR "Unhandled case ${CASE}")
    endif()
endif()
if(CASE MATCHES "^(failure|runner|cwd|dotenv|signal|original|preserve_runner)$")
    string(APPEND source "[[hooks]]\nname = \"context\"\nwhen = \"always\"\nexec = [\"${CHILD}\", \"hook_context\", \"${context_file}\"]\n")
endif()
file(WRITE "${config}" "${source}")
execute_process(COMMAND "${TATR}" --file "${config}" ${args}
    WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE actual OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT actual STREQUAL "${code}")
    message(FATAL_ERROR "${CASE}: expected ${code}, got ${actual}\n${out}\n${err}")
endif()
set(content "")
if(EXISTS "${marker}")
    file(READ "${marker}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
endif()
if(NOT content STREQUAL expected)
    message(FATAL_ERROR "${CASE}: order expected [${expected}], got [${content}]\n${err}")
endif()
if(CASE MATCHES "^(context|context_file|hook_env)$")
    file(READ "${context_file}" context)
    foreach(value "TATR_TARGET=target" "TATR_OUTCOME=success" "TATR_STATUS=0" "TATR_FAILED_TASK=\n" "TATR_CHILD_EXIT_CODE=\n" "TATR_CHILD_SIGNAL=\n" "TATR_DURATION_MS=[0-9]+")
        if(NOT context MATCHES "${value}")
            message(FATAL_ERROR "Missing context ${value}: ${context}")
        endif()
    endforeach()
    if(CASE STREQUAL "context_file")
        set(custom from-file)
    else()
        set(custom inline-secret)
    endif()
    if(NOT context MATCHES "TATR_HOOK_CUSTOM=${custom}" OR err MATCHES "inline-secret|inherited-wrong|file-wrong")
        message(FATAL_ERROR "Context precedence or secret logging failure")
    endif()
elseif(CASE STREQUAL "hook_cwd")
    file(READ "${TEST_ROOT}/work space/relative.txt" moved)
    if(NOT moved MATCHES "cwd")
        message(FATAL_ERROR "Hook cwd not applied")
    endif()
elseif(CASE MATCHES "^(off|error_level)$")
    if(NOT err MATCHES "hook 'notice'.*status 9")
        message(FATAL_ERROR "Filtered hook error was silent: ${err}")
    endif()
elseif(CASE STREQUAL "fail")
    if(NOT err MATCHES "outcome=hook_failure.*task_outcome=success")
        message(FATAL_ERROR "Final summary lost original outcome: ${err}")
    endif()
endif()

if(CASE MATCHES "^(failure|runner|cwd|dotenv|signal|original|preserve_runner)$")
    file(READ "${context_file}" context)
    if(code EQUAL 1)
        set(outcome child_failure)
        set(failed target)
    else()
        set(outcome runner_error)
        set(failed target)
    endif()
    foreach(value "TATR_TARGET=target" "TATR_OUTCOME=${outcome}" "TATR_STATUS=${code}" "TATR_FAILED_TASK=${failed}")
        if(NOT context MATCHES "${value}")
            message(FATAL_ERROR "Wrong failure context ${value}: ${context}")
        endif()
    endforeach()
    if(CASE MATCHES "^(failure|original)$" AND NOT context MATCHES "TATR_CHILD_EXIT_CODE=7")
        message(FATAL_ERROR "Native exit code lost: ${context}")
    endif()
    if(CASE STREQUAL "signal" AND NOT context MATCHES "TATR_CHILD_SIGNAL=15")
        message(FATAL_ERROR "Native signal lost: ${context}")
    endif()
endif()
