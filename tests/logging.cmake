cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_ROOT}/config" "${TEST_ROOT}/caller")
set(config "${TEST_ROOT}/config/tatr.toml")
set(directory "${TEST_ROOT}/config/logs")
set(marker "${TEST_ROOT}/executed.txt")
file(REMOVE "${marker}")
set(settings "")
set(command run target)
set(tasks "[tasks.target]\nexec = ['${CHILD}', 'record', '${marker}', 'SECRET_ARGUMENT']\nenv = { SECRET_ENV = 'SECRET_VALUE' }\n")
set(expected 0)
set(file_enabled FALSE)
set(console_enabled TRUE)
if(CASE STREQUAL "default")
elseif(CASE STREQUAL "file" OR CASE STREQUAL "append" OR CASE STREQUAL "file_only" OR
       CASE STREQUAL "unicode" OR CASE STREQUAL "tokens" OR CASE STREQUAL "defaults" OR
       CASE STREQUAL "absolute" OR CASE STREQUAL "cwd" OR CASE STREQUAL "child_output" OR
       CASE STREQUAL "child_io" OR CASE STREQUAL "escaped_task")
    set(file_enabled TRUE)
    set(settings "[logging.file]\nfilename = 'actions.log'\n")
    if(CASE STREQUAL "file_only")
        set(settings "[logging]\nconsole = false\n${settings}")
        set(console_enabled FALSE)
    elseif(CASE STREQUAL "unicode")
        set(settings "[logging.file]\ndirectory = 'space café 中文/logs'\nfilename = 'é-{{literal}}.log'\n")
        set(directory "${TEST_ROOT}/config/space café 中文/logs")
    elseif(CASE STREQUAL "tokens")
        set(settings "[logging.file]\nfilename = '{date}-{time}-{pid}.log'\n")
    elseif(CASE STREQUAL "defaults")
        set(settings "[logging.file]\n")
    elseif(CASE STREQUAL "absolute")
        set(settings "[logging.file]\ndirectory = '${directory}'\nfilename = 'actions.log'\n")
    elseif(CASE STREQUAL "cwd")
        file(MAKE_DIRECTORY "${TEST_ROOT}/task-cwd")
        string(APPEND tasks "cwd = '${TEST_ROOT}/task-cwd'\n")
    elseif(CASE STREQUAL "child_output")
        set(tasks "[tasks.target]\nexec = ['${CHILD}', 'args', 'CHILD_ONLY_OUTPUT']\n")
    elseif(CASE STREQUAL "child_io")
        set(tasks "[tasks.target]\nexec = ['${CHILD}', 'io']\n")
    elseif(CASE STREQUAL "escaped_task")
        set(target "quote\"slash\\中文")
        set(command run "${target}")
        set(tasks "[tasks.'${target}']\nexec = ['${CHILD}', 'exit', '0']\n")
    endif()
elseif(CASE STREQUAL "off" OR CASE STREQUAL "off_failure" OR CASE STREQUAL "warn" OR CASE STREQUAL "error")
    set(level "${CASE}")
    if(CASE STREQUAL "off_failure")
        set(level off)
        set(tasks "[tasks.target]\nexec = ['${CHILD}', 'exit', '7']\n")
        set(expected 1)
    endif()
    set(settings "[logging]\nlevel = '${level}'\n[logging.file]\n")
    set(console_enabled FALSE)
    if(CASE STREQUAL "warn" OR CASE STREQUAL "error")
        set(file_enabled TRUE)
    endif()
elseif(CASE STREQUAL "failure" OR CASE STREQUAL "launch" OR CASE STREQUAL "dotenv" OR
       CASE STREQUAL "filtered_failure" OR CASE STREQUAL "file_only_failure" OR
       CASE STREQUAL "signal" OR CASE STREQUAL "large_status")
    set(file_enabled TRUE)
    set(settings "[logging.file]\nfilename = 'actions.log'\n")
    set(expected 2)
    if(CASE STREQUAL "failure" OR CASE STREQUAL "filtered_failure" OR
       CASE STREQUAL "file_only_failure" OR CASE STREQUAL "large_status")
        set(expected 1)
        set(tasks "[tasks.target]\nexec = ['${CHILD}', 'exit', '7']\n")
        if(CASE STREQUAL "filtered_failure")
            set(settings "[logging]\nlevel = 'error'\n${settings}")
        elseif(CASE STREQUAL "file_only_failure")
            set(settings "[logging]\nconsole = false\n${settings}")
            set(console_enabled FALSE)
        elseif(CASE STREQUAL "large_status")
            set(tasks "[tasks.target]\nexec = ['${CHILD}', 'exit', '4294967295']\n")
        endif()
    elseif(CASE STREQUAL "signal")
        set(expected 1)
        set(tasks "[tasks.target]\nexec = ['${CHILD}', 'signal']\n")
    elseif(CASE STREQUAL "launch")
        set(tasks "[tasks.target]\nexec = ['missing-tatr-executable']\n")
    else()
        string(APPEND tasks "env_file = 'missing.env'\n")
    endif()
elseif(CASE STREQUAL "group" OR CASE STREQUAL "shared")
    set(tasks "[tasks.target]\ndepends = ['left', 'right']\n[tasks.left]\ndepends = ['shared']\n[tasks.right]\ndepends = ['shared']\n[tasks.shared]\n")
    if(CASE STREQUAL "shared")
        string(APPEND tasks "exec = ['${CHILD}', 'record', '${marker}', 'once']\n")
    endif()
elseif(CASE STREQUAL "file_write_failure")
    set(settings "[logging]\nconsole = false\n[logging.file]\nfilename = 'actions.log'\n")
    set(expected 2)
elseif(CASE STREQUAL "open_failure")
    file(WRITE "${TEST_ROOT}/config/not-directory" "file")
    set(settings "[logging]\nconsole = false\n[logging.file]\ndirectory = 'not-directory/logs'\n")
    set(expected 2)
elseif(CASE STREQUAL "list" OR CASE STREQUAL "plan" OR CASE STREQUAL "unknown_target" OR CASE STREQUAL "group_args")
    set(settings "[logging.file]\n")
    set(console_enabled FALSE)
    if(CASE STREQUAL "list")
        set(command list)
    elseif(CASE STREQUAL "plan")
        set(command plan target)
    elseif(CASE STREQUAL "unknown_target")
        set(command run missing)
        set(expected 2)
    else()
        set(tasks "[tasks.target]\n")
        set(command run target -- arg)
        set(expected 2)
    endif()
else()
    set(expected 2)
    if(CASE STREQUAL "invalid_level")
        set(settings "[logging]\nlevel = 'debug'\n")
    elseif(CASE STREQUAL "level_type")
        set(settings "[logging]\nlevel = 1\n")
    elseif(CASE STREQUAL "console_type")
        set(settings "[logging]\nconsole = 'yes'\n")
    elseif(CASE STREQUAL "silent")
        set(settings "[logging]\nconsole = false\n")
    elseif(CASE STREQUAL "logging_type")
        set(settings "logging = 1\n")
    elseif(CASE STREQUAL "file_type")
        set(settings "[logging]\nfile = 'x'\n")
    elseif(CASE STREQUAL "unknown_field")
        set(settings "[logging]\ncolour = true\n")
    elseif(CASE STREQUAL "unknown_file_field")
        set(settings "[logging.file]\nrotate = true\n")
    elseif(CASE STREQUAL "directory_type")
        set(settings "[logging.file]\ndirectory = false\n")
    elseif(CASE STREQUAL "filename_type")
        set(settings "[logging.file]\nfilename = 1\n")
    elseif(CASE STREQUAL "empty_directory")
        set(settings "[logging.file]\ndirectory = ''\n")
    elseif(CASE STREQUAL "nul_directory")
        set(settings "[logging.file]\ndirectory = \"a\\u0000b\"\n")
    elseif(CASE STREQUAL "bad_filename")
        set(settings "[logging.file]\nfilename = '../escape.log'\n")
    elseif(CASE STREQUAL "bad_token")
        set(settings "[logging.file]\nfilename = '{task}.log'\n")
    elseif(CASE STREQUAL "reserved")
        set(settings "[logging.file]\nfilename = 'NUL.log'\n")
    elseif(CASE STREQUAL "drive_relative")
        set(settings "[logging.file]\ndirectory = 'C:logs'\n")
    else()
        message(FATAL_ERROR "unknown case: ${CASE}")
    endif()
endif()
file(WRITE "${config}" "version = 1\n${settings}${tasks}")
# Keep reruns deterministic without deleting directories recursively.
file(GLOB stale "${directory}/*.log")
if(stale)
    file(REMOVE ${stale})
endif()
if(CASE STREQUAL "append")
    file(MAKE_DIRECTORY "${directory}")
    file(CONFIGURE OUTPUT "${directory}/actions.log" CONTENT "existing\n" @ONLY NEWLINE_STYLE UNIX)
endif()
if(CASE STREQUAL "file_write_failure")
    file(MAKE_DIRECTORY "${directory}")
    file(CREATE_LINK /dev/full "${directory}/actions.log" SYMBOLIC)
endif()
file(CONFIGURE OUTPUT "${TEST_ROOT}/input.txt" CONTENT "child text\n" @ONLY NEWLINE_STYLE UNIX)
execute_process(COMMAND "${TATR}" --file "${config}" ${command}
    WORKING_DIRECTORY "${TEST_ROOT}/caller" RESULT_VARIABLE code OUTPUT_VARIABLE output
    ERROR_VARIABLE error INPUT_FILE "${TEST_ROOT}/input.txt" ENCODING UTF-8 TIMEOUT 15)
include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
assert_no_sanitizer_diagnostic("${output}" "${error}")
if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "${CASE}: expected ${expected}, got ${code}: ${output} ${error}")
endif()
file(GLOB logs "${directory}/*.log")
if(CASE STREQUAL "file_write_failure")
    file(REMOVE "${directory}/actions.log")
    if(EXISTS "${marker}" OR NOT error MATCHES "^tatr: logging: cannot write log file record")
        message(FATAL_ERROR "failed file sink did not stop child with fallback: ${error}")
    endif()
    return()
endif()
if(file_enabled)
    list(LENGTH logs count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "expected one log: ${logs}")
    endif()
    list(GET logs 0 logfile)
    file(READ "${logfile}" content)
    if(CASE STREQUAL "append")
        if(NOT content MATCHES "^existing\n")
            message(FATAL_ERROR "existing log truncated")
        endif()
        string(REGEX REPLACE "^existing\n" "" content "${content}")
    endif()
    set(records "${error}")
    if(CASE STREQUAL "child_io")
        if(NOT output STREQUAL "stdout:child text\n" OR NOT error MATCHES "stderr:child text\n" OR
           content MATCHES "stdout:|stderr:")
            message(FATAL_ERROR "child streams should remain inherited and absent from file")
        endif()
        string(REPLACE "stderr:child text\n" "" records "${records}")
    endif()
    if(console_enabled AND NOT content STREQUAL records)
        message(FATAL_ERROR "console/file differ: ${error} vs ${content}")
    endif()
    if(CASE STREQUAL "escaped_task")
        string(FIND "${content}" [=[task="quote\"slash\\中文"]=] found)
        if(found EQUAL -1)
            message(FATAL_ERROR "task string was not escaped: ${content}")
        endif()
    endif()
    if(content MATCHES "SECRET_ARGUMENT|SECRET_VALUE|SECRET_ENV")
        message(FATAL_ERROR "sensitive inputs leaked")
    endif()
    if(NOT CASE STREQUAL "warn" AND NOT CASE STREQUAL "error" AND NOT CASE STREQUAL "filtered_failure" AND
       (NOT content MATCHES "event=run_started" OR NOT content MATCHES "event=run_finished"))
        message(FATAL_ERROR "missing run events: ${content}")
    endif()
    if(CASE STREQUAL "child_output" AND (output STREQUAL "" OR content MATCHES "CHILD_ONLY_OUTPUT|4348494c44"))
        message(FATAL_ERROR "child stdout must remain on console only")
    endif()
    if(CASE STREQUAL "filtered_failure" AND (content MATCHES "level=info" OR NOT content MATCHES "level=error"))
        message(FATAL_ERROR "threshold lost error or retained info")
    endif()
    if(CASE STREQUAL "signal" AND NOT content MATCHES "outcome=child_failure signal=[0-9]+")
        message(FATAL_ERROR "native signal missing")
    endif()
    if(CASE STREQUAL "large_status" AND NOT content MATCHES "exit_code=4294967295")
        message(FATAL_ERROR "native Windows status truncated")
    endif()
    file(READ "${logfile}" bytes HEX)
    if(bytes MATCHES "0d0a" OR bytes MATCHES "^efbbbf")
        message(FATAL_ERROR "file must be UTF-8 without BOM and LF")
    endif()
elseif(logs)
    message(FATAL_ERROR "unexpected log files: ${logs}")
endif()
if(NOT file_enabled AND EXISTS "${directory}")
    message(FATAL_ERROR "nonlogging invocation created log directory")
endif()
if(CASE STREQUAL "tokens")
    get_filename_component(name "${logfile}" NAME)
    if(NOT name MATCHES "^[0-9]+-[0-9]+-[0-9]+-[0-9]+Z-[0-9]+[.]log$")
        message(FATAL_ERROR "unexpected expanded filename ${name}")
    endif()
endif()
if(expected EQUAL 0 AND NOT console_enabled AND NOT error STREQUAL "")
    message(FATAL_ERROR "unexpected console output: ${error}")
endif()
if(expected EQUAL 2 AND EXISTS "${marker}")
    message(FATAL_ERROR "invalid run launched child")
endif()
if(CASE STREQUAL "default" OR CASE STREQUAL "file" OR CASE STREQUAL "append")
    if(NOT error MATCHES "event=task_finished task=\"target\" outcome=success exit_code=0 duration_ms=[0-9]+")
        message(FATAL_ERROR "missing task outcome: ${error}")
    endif()
elseif(CASE STREQUAL "failure")
    if(NOT error MATCHES "outcome=child_failure exit_code=7" OR error MATCHES "tatr: ")
        message(FATAL_ERROR "incorrect failure reporting: ${error}")
    endif()
elseif(CASE STREQUAL "launch" OR CASE STREQUAL "dotenv")
    if(NOT error MATCHES "event=task_started" OR NOT error MATCHES "outcome=runner_error")
        message(FATAL_ERROR "missing runner failure: ${error}")
    endif()
elseif(CASE STREQUAL "group")
    if(error MATCHES "event=task_")
        message(FATAL_ERROR "grouping task emitted executable events")
    endif()
elseif(CASE STREQUAL "shared")
    string(REGEX MATCHALL "event=task_started" starts "${error}")
    list(LENGTH starts count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "shared dependency logged more than once: ${error}")
    endif()
elseif(CASE STREQUAL "off_failure")
    if(NOT error MATCHES "^tatr: .*exited with status 7")
        message(FATAL_ERROR "missing off fallback diagnostic: ${error}")
    endif()
endif()
