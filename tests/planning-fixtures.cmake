set(source [=[version = 1
[tasks.test]
depends = ["build"]
[tasks.build]
depends = ["configure"]
[tasks.configure]
description = "Not printed in a plan"
[tasks.unrelated]
]=])
set(arguments plan test)
set(expected_output "configure\nbuild\ntest\n")

if(CASE STREQUAL "plan_chain")
    # Defaults exercise forward references and exclude unrelated tasks.
elseif(CASE STREQUAL "plan_single")
    set(arguments plan configure)
    set(expected_output "configure\n")
elseif(CASE STREQUAL "plan_shared" OR CASE STREQUAL "plan_branches")
    set(source [=[version = 1
[tasks.release]
depends = ["zeta", "alpha"]
[tasks.zeta]
depends = ["shared"]
[tasks.alpha]
depends = ["shared"]
[tasks.shared]
]=])
    set(arguments plan release)
    set(expected_output "shared\nzeta\nalpha\nrelease\n")
    if(CASE STREQUAL "plan_branches")
        set(source "version = 1\n[tasks.release]\ndepends = [\"zeta\", \"alpha\"]\n[tasks.alpha]\n[tasks.zeta]\n")
        set(expected_output "zeta\nalpha\nrelease\n")
    endif()
elseif(CASE STREQUAL "plan_unicode")
    set(source "version = 1\n[tasks.\"测试\"]\ndepends = [\"编译\"]\n[tasks.\"编译\"]\n")
    set(arguments plan 测试)
    set(expected_output "编译\n测试\n")
elseif(CASE STREQUAL "plan_dotted")
    set(source "version = 1\n[tasks.\"test.debug\"]\ndepends = [\"build.debug\"]\n[tasks.\"build.debug\"]\n")
    set(arguments plan test.debug)
    set(expected_output "build.debug\ntest.debug\n")
elseif(CASE MATCHES "^plan_file_(before|middle|after)$")
    set(config "${TEST_ROOT}/配置 with spaces.toml")
    if(CASE STREQUAL "plan_file_before")
        set(arguments --file "${config}" plan test)
    elseif(CASE STREQUAL "plan_file_middle")
        set(arguments plan --file "${config}" test)
    else()
        set(arguments plan test --file "${config}")
    endif()
elseif(CASE STREQUAL "plan_named_command")
    set(source "version = 1\n[tasks.list]\n[tasks.plan]\ndepends = [\"list\"]\n")
    set(arguments plan plan)
    set(expected_output "list\nplan\n")
elseif(CASE STREQUAL "plan_long_chain")
    set(source "version = 1\n[tasks.task0]\n")
    set(expected_output "task0\n")
    foreach(index RANGE 1 2000)
        math(EXPR previous "${index} - 1")
        string(APPEND source "[tasks.task${index}]\ndepends = [\"task${previous}\"]\n")
        string(APPEND expected_output "task${index}\n")
    endforeach()
    set(arguments plan task2000)
elseif(CASE STREQUAL "depends_empty")
    set(source "version = 1\n[tasks.build]\ndepends = []\n")
    set(arguments list)
    set(expected_output "build\n")
else()
    set(expected_code 2)
    if(CASE STREQUAL "plan_unknown" OR CASE STREQUAL "plan_empty_tasks")
        set(arguments plan absent)
        set(expected_error "unknown task 'absent'")
        if(CASE STREQUAL "plan_empty_tasks")
            set(source "version = 1\n[tasks]\n")
        endif()
    elseif(CASE STREQUAL "plan_missing_target" OR CASE STREQUAL "plan_empty_target")
        set(arguments plan)
        set(expected_error "plan requires a task name")
    elseif(CASE STREQUAL "plan_extra_target")
        set(arguments plan test build)
        set(expected_error "unexpected argument 'build'")
    elseif(CASE STREQUAL "plan_option_target")
        set(arguments plan --help)
        set(expected_error "unknown or misplaced option")
    elseif(CASE STREQUAL "plan_unrelated_missing")
        string(APPEND source "[tasks.zzinvalid]\ndepends = [\"absent\"]\n")
        set(expected_error "task 'zzinvalid': missing dependency 'absent'")
    elseif(CASE STREQUAL "plan_unrelated_cycle")
        string(APPEND source "[tasks.zzinvalid]\ndepends = [\"zzinvalid\"]\n")
        set(expected_error "dependency cycle: 'zzinvalid' -> 'zzinvalid'")
    else()
        set(arguments list)
        set(dependencies "[]")
        if(CASE STREQUAL "depends_type")
            set(dependencies "\"configure\"")
            set(expected_error "depends: expected an array")
        elseif(CASE STREQUAL "depends_item_type" OR CASE STREQUAL "depends_mixed")
            set(dependencies "[42]")
            if(CASE STREQUAL "depends_mixed")
                set(dependencies "[\"configure\", false]")
            endif()
            set(expected_error "depends: expected a task-name string")
        elseif(CASE MATCHES "^depends_(empty_name|control|c1|nul)$")
            if(CASE STREQUAL "depends_empty_name")
                set(dependencies [=[[""]]=])
            elseif(CASE STREQUAL "depends_control")
                set(dependencies [=[["bad\nname"]]=])
            elseif(CASE STREQUAL "depends_c1")
                set(dependencies [=[["bad\u0085name"]]=])
            else()
                set(dependencies [=[["bad\u0000name"]]=])
            endif()
            set(expected_error "dependency names must be nonempty and contain no control characters")
        elseif(CASE STREQUAL "depends_duplicate")
            set(dependencies "[\"configure\", \"configure\"]")
            set(expected_error "duplicate dependency 'configure'")
        elseif(CASE STREQUAL "depends_missing")
            set(dependencies "[\"absent\"]")
            set(expected_error "task 'build': missing dependency 'absent'")
        elseif(CASE STREQUAL "depends_self_cycle")
            set(dependencies "[\"build\"]")
            set(expected_error "dependency cycle: 'build' -> 'build'")
        elseif(CASE STREQUAL "depends_cycle" OR CASE STREQUAL "depends_disconnected_cycle")
            set(dependencies "[\"configure\"]")
            set(expected_error "dependency cycle: 'build' -> 'configure' -> 'build'")
        else()
            message(FATAL_ERROR "Unknown planning case: ${CASE}")
        endif()
        set(source "version = 1\n[tasks.build]\ndepends = ${dependencies}\n[tasks.configure]\n")
        if(CASE STREQUAL "depends_cycle" OR CASE STREQUAL "depends_disconnected_cycle")
            string(APPEND source "depends = [\"build\"]\n")
            if(CASE STREQUAL "depends_disconnected_cycle")
                string(APPEND source "[tasks.aaa_valid]\n")
            endif()
        endif()
    endif()
endif()
