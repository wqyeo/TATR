cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_ROOT}/private temp" "${TEST_ROOT}/fake")
set(private_temp "${TEST_ROOT}/private temp")
if(NOT WIN32)
    # Windows bind mounts do not necessarily implement private POSIX permissions.
    string(SHA256 identity "${TEST_ROOT}")
    set(private_temp "/tmp/tatr-smtp-test-${identity}")
    file(MAKE_DIRECTORY "${private_temp}")
endif()
set(ENV{TMPDIR} "${private_temp}")
set(ENV{TMP} "${TEST_ROOT}/private temp")
set(ENV{TEMP} "${TEST_ROOT}/private temp")
set(ENV{TATR_FAKE_DIR} "${TEST_ROOT}/fake")
set(ENV{TATR_FAKE_EXIT} "")
set(ENV{TATR_FAKE_EARLY} "")
set(ENV{TATR_FAKE_REMOVE} "")
set(ENV{SMTP_USERNAME} "inherited-user")
set(ENV{SMTP_PASSWORD} "inherited-CREDENTIAL-MARKER")
file(REMOVE "${TEST_ROOT}/fake/client.txt" "${TEST_ROOT}/fake/message.eml" "${TEST_ROOT}/marker" "${TEST_ROOT}/fake/failure.txt")
file(WRITE "${TEST_ROOT}/smtp.env" "SMTP_USERNAME=file-user\nSMTP_PASSWORD=file-CREDENTIAL-MARKER\n")
set(base "version = 1\n[tasks.group]\n[tasks.prerequisite]\nexec = [\"${CHILD}\", \"record\", \"${TEST_ROOT}/marker\", \"prerequisite\"]\n")
set(action "[tasks.mail]\ndepends = [\"prerequisite\"]\nenv_file = \"smtp.env\"\n")
set(settings "[tasks.mail.smtp]\nhost = \"localhost\"\nport = 587\ntls = \"starttls\"\nfrom = \"sender@example.com\"\nto = [\"recipient@example.com\"]\nsubject = \"Deployment café 中文\"\nbody = \"Hello café 中文\\n\"\nclient = \"${CLIENT}\"\n")
set(auth "[tasks.mail.smtp.auth]\nusername_env = \"SMTP_USERNAME\"\npassword_env = \"SMTP_PASSWORD\"\n")
set(args run mail)
set(expected_code 0)
set(expect_client TRUE)
set(expect_prerequisite TRUE)
if(CASE STREQUAL "inline")
    string(APPEND action "env = { SMTP_USERNAME = \"inline-user\", SMTP_PASSWORD = \"inline-CREDENTIAL-MARKER\" }\n")
elseif(CASE STREQUAL "inherited")
    string(REPLACE "env_file = \"smtp.env\"\n" "" action "${action}")
elseif(CASE STREQUAL "no_auth")
    set(auth "")
elseif(CASE STREQUAL "body_file")
    execute_process(COMMAND "${CHILD}" write_hex "${TEST_ROOT}/message.txt" efbbbf426f64792066726f6d2066696c650a COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "body = \"Hello café 中文\\n\"" "body_file = \"message.txt\"" settings "${settings}")
elseif(CASE STREQUAL "generated_body")
    file(REMOVE "${TEST_ROOT}/generated.txt")
    string(REPLACE "\"record\", \"${TEST_ROOT}/marker\", \"prerequisite\"" "\"write_hex\", \"${TEST_ROOT}/generated.txt\", \"67656e657261746564\"" base "${base}")
    string(REPLACE "body = \"Hello café 中文\\n\"" "body_file = \"generated.txt\"" settings "${settings}")
    set(expect_prerequisite FALSE)
elseif(CASE STREQUAL "cwd")
    string(APPEND action "cwd = \"fake\"\n")
elseif(CASE STREQUAL "client_failure")
    set(ENV{TATR_FAKE_EXIT} "67")
    set(expected_code 1)
elseif(CASE STREQUAL "early_exit")
    set(ENV{TATR_FAKE_EARLY} "1")
    set(expected_code 1)
    set(expect_client FALSE)
elseif(CASE STREQUAL "cleanup_error")
    set(ENV{TATR_FAKE_REMOVE} "1")
    set(expected_code 2)
elseif(CASE STREQUAL "cleanup_preserves_client")
    set(ENV{TATR_FAKE_REMOVE} "1")
    set(ENV{TATR_FAKE_EXIT} "67")
    set(expected_code 1)
elseif(CASE MATCHES "^(missing_auth|empty_auth|invalid_auth|oversized_auth|client_missing|body_missing|body_directory|body_oversize|body_lone_cr|body_nul|body_invalid_utf8|cwd_missing|dotenv_missing)$")
    set(expected_code 2)
    set(expect_client FALSE)
    if(CASE STREQUAL "missing_auth")
        string(REPLACE "username_env = \"SMTP_USERNAME\"" "username_env = \"SMTP_ABSENT\"" auth "${auth}")
    elseif(CASE STREQUAL "empty_auth")
        string(APPEND action "env = { SMTP_PASSWORD = \"\" }\n")
    elseif(CASE STREQUAL "invalid_auth")
        string(APPEND action "env = { SMTP_PASSWORD = \"CREDENTIAL-MARKER\\n\" }\n")
    elseif(CASE STREQUAL "oversized_auth")
        string(REPEAT "x" 4097 password)
        string(APPEND action "env = { SMTP_PASSWORD = \"${password}\" }\n")
    elseif(CASE STREQUAL "client_missing")
        string(REPLACE "${CLIENT}" "tatr-absent-smtp-client" settings "${settings}")
    elseif(CASE STREQUAL "cwd_missing")
        string(APPEND action "cwd = \"absent directory\"\n")
    elseif(CASE STREQUAL "dotenv_missing")
        string(REPLACE "smtp.env" "absent.env" action "${action}")
    else()
        set(path "${TEST_ROOT}/body.txt")
        file(REMOVE "${path}")
        if(CASE STREQUAL "body_directory")
            set(path "${TEST_ROOT}/fake")
        elseif(CASE STREQUAL "body_oversize")
            string(REPEAT "x" 65537 contents)
            file(WRITE "${path}" "${contents}")
        elseif(CASE STREQUAL "body_lone_cr")
            file(WRITE "${path}" "a\rb")
        elseif(CASE STREQUAL "body_nul")
            execute_process(COMMAND "${CHILD}" write_hex "${path}" 610062 COMMAND_ERROR_IS_FATAL ANY)
        elseif(CASE STREQUAL "body_invalid_utf8")
            execute_process(COMMAND "${CHILD}" write_hex "${path}" ff COMMAND_ERROR_IS_FATAL ANY)
        endif()
        string(REPLACE "body = \"Hello café 中文\\n\"" "body_file = \"${path}\"" settings "${settings}")
    endif()
elseif(CASE MATCHES "^hook_")
    set(args run group)
    set(action "[[hooks]]\nname = \"email\"\nwhen = \"always\"\ntargets = [\"group\"]\nenv_file = \"smtp.env\"\n")
    string(REPLACE "tasks.mail.smtp" "hooks.smtp" settings "${settings}")
    string(REPLACE "body = \"Hello café 中文\\n\"\n" "" settings "${settings}")
    string(REPLACE "tasks.mail.smtp" "hooks.smtp" auth "${auth}")
    set(expect_prerequisite FALSE)
    if(CASE STREQUAL "hook_original")
        string(REPLACE "[tasks.group]" "[tasks.group]\nexec = [\"${CHILD}\", \"exit\", \"7\"]" base "${base}")
        set(ENV{TATR_FAKE_EXIT} "67")
        string(APPEND action "on_error = \"fail\"\n")
        set(expected_code 1)
    elseif(CASE STREQUAL "hook_warn")
        set(ENV{TATR_FAKE_EXIT} "67")
    elseif(CASE STREQUAL "hook_required")
        set(ENV{TATR_FAKE_EXIT} "67")
        string(APPEND action "on_error = \"fail\"\n")
        set(expected_code 1)
    elseif(CASE STREQUAL "hook_filter")
        string(REPLACE "targets = [\"group\"]" "targets = [\"prerequisite\"]" action "${action}")
        set(expect_client FALSE)
    elseif(CASE STREQUAL "hook_context_auth")
        string(APPEND action "env = { TATR_TARGET = \"wrong\" }\n")
        string(REPLACE "username_env = \"SMTP_USERNAME\"" "username_env = \"TATR_TARGET\"" auth "${auth}")
        # Fake expects SMTP_USERNAME; set it to the reserved context's actual value.
        string(APPEND action "env = { SMTP_USERNAME = \"group\" }\n")
        string(REPLACE "env = { TATR_TARGET = \"wrong\" }\n" "" action "${action}")
    endif()
elseif(CASE MATCHES "^(list|plan|unselected|arguments)$")
    string(REPLACE "${CLIENT}" "tatr-absent-smtp-client" settings "${settings}")
    string(REPLACE "smtp.env" "absent.env" action "${action}")
    string(REPLACE "body = \"Hello café 中文\\n\"" "body_file = \"absent.txt\"\nca_file = \"absent.pem\"" settings "${settings}")
    set(expect_client FALSE)
    set(expect_prerequisite FALSE)
    if(CASE STREQUAL "list")
        set(args list)
    elseif(CASE STREQUAL "plan")
        set(args plan mail)
    elseif(CASE STREQUAL "unselected")
        set(args run group)
    else()
        set(args run mail -- injected)
        set(expected_code 2)
    endif()
elseif(CASE MATCHES "^invalid_")
    set(expected_code 2)
    set(expect_client FALSE)
    set(expect_prerequisite FALSE)
    if(CASE STREQUAL "invalid_action")
        string(APPEND action "exec = [\"${CHILD}\", \"exit\", \"0\"]\n")
    elseif(CASE STREQUAL "invalid_type")
        set(settings "smtp = 1\n")
        set(auth "")
    elseif(CASE STREQUAL "invalid_host")
        string(REPLACE "localhost" "smtp://user:pass@host" settings "${settings}")
    elseif(CASE STREQUAL "invalid_port")
        string(REPLACE "port = 587" "port = 65536" settings "${settings}")
    elseif(CASE STREQUAL "invalid_tls")
        string(REPLACE "starttls" "none" settings "${settings}")
    elseif(CASE STREQUAL "invalid_header")
        string(REPLACE "sender@example.com" "sender@example.com\\r\\nBcc:x@y" settings "${settings}")
    elseif(CASE STREQUAL "invalid_subject")
        string(REPLACE "Deployment café 中文" "CREDENTIAL-MARKER\\nInjected" settings "${settings}")
    elseif(CASE STREQUAL "invalid_to")
        string(REPLACE "to = [\"recipient@example.com\"]" "to = []" settings "${settings}")
    elseif(CASE STREQUAL "invalid_duplicate_to")
        string(REPLACE "to = [\"recipient@example.com\"]" "to = [\"a@Example.com\", \"a@example.com\"]" settings "${settings}")
    elseif(CASE STREQUAL "invalid_content")
        string(REPLACE "body = \"Hello café 中文\\n\"\n" "" settings "${settings}")
    elseif(CASE STREQUAL "invalid_bodies")
        string(APPEND settings "body_file = \"x\"\n")
    elseif(CASE STREQUAL "invalid_timeout")
        string(APPEND settings "connect_timeout_seconds = 31\ntimeout_seconds = 30\n")
    elseif(CASE STREQUAL "invalid_auth_schema")
        string(REPLACE "password_env = \"SMTP_PASSWORD\"" "" auth "${auth}")
    elseif(CASE STREQUAL "invalid_field")
        string(APPEND settings "password = \"CREDENTIAL-MARKER\"\n")
    elseif(CASE STREQUAL "invalid_client")
        string(REPLACE "client = \"${CLIENT}\"" "client = \"\"" settings "${settings}")
    endif()
endif()
if(CASE STREQUAL "basic")
    string(REPLACE "version = 1\n" "version = 1\n[logging.file]\ndirectory = \"logs\"\nfilename = \"smtp.log\"\n" base "${base}")
    file(REMOVE "${TEST_ROOT}/logs/smtp.log")
endif()
file(WRITE "${TEST_ROOT}/tatr.toml" "${base}${action}${settings}${auth}")
execute_process(COMMAND "${TATR}" --file "${TEST_ROOT}/tatr.toml" ${args}
    WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 20)
if(EXISTS "${TEST_ROOT}/fake/failure.txt")
    file(READ "${TEST_ROOT}/fake/failure.txt" fixture_error)
    message(FATAL_ERROR "Fake client assertion failed: ${fixture_error}")
endif()
if(NOT code STREQUAL "${expected_code}")
    message(FATAL_ERROR "${CASE}: expected ${expected_code}, got ${code}\n${out}\n${err}")
endif()
if(out MATCHES "CREDENTIAL-MARKER|RAW-SMTP" OR err MATCHES "CREDENTIAL-MARKER|RAW-SMTP")
    message(FATAL_ERROR "SMTP action exposed credentials or raw diagnostics")
endif()
if(expect_client AND NOT EXISTS "${TEST_ROOT}/fake/client.txt")
    message(FATAL_ERROR "Client did not verify invocation: ${err}")
elseif(NOT expect_client AND EXISTS "${TEST_ROOT}/fake/client.txt")
    message(FATAL_ERROR "Unexpected client invocation")
endif()
if(expect_prerequisite AND NOT EXISTS "${TEST_ROOT}/marker")
    message(FATAL_ERROR "Prerequisite did not execute")
elseif(NOT expect_prerequisite AND EXISTS "${TEST_ROOT}/marker")
    message(FATAL_ERROR "Unexpected prerequisite execution")
endif()
file(GLOB leftovers "${private_temp}/tatr-smtp-*")
if(leftovers)
    message(FATAL_ERROR "Private message files leaked: ${leftovers}")
endif()
if(CASE MATCHES "^hook_" AND expect_client)
    file(READ "${TEST_ROOT}/fake/message.eml" message)
    if(NOT message MATCHES "Target:=20group")
        message(FATAL_ERROR "Default hook summary missing target")
    endif()
endif()

if(CASE STREQUAL "basic")
    file(READ "${TEST_ROOT}/logs/smtp.log" actions)
    if(actions MATCHES "CREDENTIAL-MARKER|RAW-SMTP" OR NOT actions MATCHES "event=task_finished task=\"mail\" outcome=success")
        message(FATAL_ERROR "SMTP file action log is incorrect or exposes sensitive values")
    endif()
endif()
