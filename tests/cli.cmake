cmake_minimum_required(VERSION 3.25)

file(MAKE_DIRECTORY "${TEST_ROOT}")
set(config "${TEST_ROOT}/tatr.toml")
set(working_directory "${TEST_ROOT}")
set(arguments list)
set(expected_code 0)
set(expected_output "build - Build the project\ncheck\nzebra - Last task\n")
set(expected_error "")
set(source [=[version = 1
[tasks.zebra]
description = "Last task"
[tasks.check]
[tasks.build]
description = "Build the project"
]=])

if(CASE MATCHES "^(plan_|depends_)")
    include("${CMAKE_CURRENT_LIST_DIR}/planning-fixtures.cmake")
elseif(CASE STREQUAL "help" OR CASE STREQUAL "no_arguments")
    file(MAKE_DIRECTORY "${TEST_ROOT}/without-config")
    set(working_directory "${TEST_ROOT}/without-config")
    set(expected_output "__HELP__")
    set(arguments)
    if(CASE STREQUAL "help")
        set(arguments --help)
    endif()
elseif(CASE STREQUAL "version")
    set(arguments --version)
    set(expected_output "tatr ${VERSION}\n")
    # Invalid configuration must not affect --version.
    set(source "version = [")
elseif(CASE STREQUAL "list_default")
    # Defaults are sufficient.
elseif(CASE STREQUAL "list_file")
    set(config "${TEST_ROOT}/file with spaces.toml")
    set(arguments --file "${config}" list)
elseif(CASE STREQUAL "file_after_command")
    set(arguments list --file "${config}")
elseif(CASE STREQUAL "empty_tasks")
    set(source "version = 1\n[tasks]\n")
    set(expected_output "")
elseif(CASE STREQUAL "absent_description")
    set(source "version = 1\n[tasks.build]\n")
    set(expected_output "build\n")
elseif(CASE STREQUAL "empty_description")
    set(source "version = 1\n[tasks.build]\ndescription = \"\"\n")
    set(expected_output "build\n")
elseif(CASE STREQUAL "unicode")
    set(source "version = 1\n[tasks.\"编译\"]\ndescription = \"构建项目 — café\"\n")
    set(expected_output "编译 - 构建项目 — café\n")
elseif(CASE STREQUAL "unicode_file")
    set(config "${TEST_ROOT}/配置 café.toml")
    set(arguments --file "${config}" list)
elseif(CASE STREQUAL "dotted_name")
    set(source "version = 1\n[tasks.\"build.debug\"]\n")
    set(expected_output "build.debug\n")
elseif(CASE STREQUAL "no_parent_search")
    file(MAKE_DIRECTORY "${TEST_ROOT}/child")
    set(working_directory "${TEST_ROOT}/child")
    set(expected_code 2)
    set(expected_error "cannot open configuration file")
elseif(CASE STREQUAL "missing_file")
    set(arguments --file "${TEST_ROOT}/missing.toml" list)
    set(expected_code 2)
    set(expected_error "missing.toml: cannot open configuration file")
elseif(CASE STREQUAL "malformed")
    set(source "version = [")
    set(expected_code 2)
    set(expected_error "tatr.toml:")
elseif(CASE STREQUAL "duplicate_key")
    set(source "version = 1\nversion = 1\n[tasks]\n")
    set(expected_code 2)
    set(expected_error "tatr.toml:")
elseif(CASE STREQUAL "missing_version")
    set(source "[tasks]\n")
    set(expected_code 2)
    set(expected_error "version: expected integer 1")
elseif(CASE MATCHES "^(wrong_version|version_string|version_float|version_boolean)$")
    if(CASE STREQUAL "wrong_version")
        set(version_value 2)
    elseif(CASE STREQUAL "version_string")
        set(version_value "\"1\"")
    elseif(CASE STREQUAL "version_float")
        set(version_value "1.0")
    else()
        set(version_value true)
    endif()
    set(source "version = ${version_value}\n[tasks]\n")
    set(expected_code 2)
    set(expected_error "version: expected integer 1")
elseif(CASE STREQUAL "missing_tasks" OR CASE STREQUAL "tasks_array")
    set(source "version = 1\n")
    if(CASE STREQUAL "tasks_array")
        string(APPEND source "tasks = []\n")
    endif()
    set(expected_code 2)
    set(expected_error "tasks: expected a table")
elseif(CASE STREQUAL "task_scalar" OR CASE STREQUAL "task_array")
    set(source "version = 1\n[tasks]\nbuild = 42\n")
    if(CASE STREQUAL "task_array")
        set(source "version = 1\n[[tasks.build]]\n")
    endif()
    set(expected_code 2)
    set(expected_error "task 'build': expected a table")
elseif(CASE STREQUAL "description_type" OR CASE STREQUAL "late_invalid_task")
    if(CASE STREQUAL "late_invalid_task")
        string(APPEND source "[tasks.zzinvalid]\ndescription = 42\n")
        set(expected_error "task 'zzinvalid'.description: expected a string")
    else()
        set(source "version = 1\n[tasks.build]\ndescription = 42\n")
        set(expected_error "task 'build'.description: expected a string")
    endif()
    set(expected_code 2)
elseif(CASE STREQUAL "unknown_root")
    set(source "version = 1\nunexpected = true\n[tasks]\n")
    set(expected_code 2)
    set(expected_error "configuration: unsupported field 'unexpected'")
elseif(CASE STREQUAL "unknown_task")
    set(source "version = 1\n[tasks.build]\ndescripton = \"typo\"\n")
    set(expected_code 2)
    set(expected_error "task 'build': unsupported field 'descripton'")
elseif(CASE MATCHES "^unsupported_(cwd|env)$")
    set(field "${CMAKE_MATCH_1}")
    set(source "version = 1\n[tasks.build]\n${field} = []\n")
    set(expected_code 2)
    set(expected_error "task 'build': unsupported field '${field}'")
elseif(CASE STREQUAL "empty_name")
    set(source "version = 1\n[tasks.\"\"]\n")
    set(expected_code 2)
    set(expected_error "task names must be nonempty")
elseif(CASE MATCHES "^(control_name|c1_name|nul_key)$")
    if(CASE STREQUAL "control_name")
        set(escaped [=[bad\u001bname]=])
    elseif(CASE STREQUAL "c1_name")
        set(escaped [=[bad\u0085name]=])
    else()
        set(escaped [=[bad\u0000name]=])
    endif()
    set(source "version = 1\n[tasks.\"${escaped}\"]\n")
    set(expected_code 2)
    set(expected_error "task names must be nonempty")
elseif(CASE MATCHES "^(control_description|c1_description|nul_description)$")
    if(CASE STREQUAL "control_description")
        set(escaped [=[line\nbreak]=])
    elseif(CASE STREQUAL "c1_description")
        set(escaped [=[line\u0085break]=])
    else()
        set(escaped [=[line\u0000break]=])
    endif()
    set(source "version = 1\n[tasks.build]\ndescription = \"${escaped}\"\n")
    set(expected_code 2)
    set(expected_error "description: control characters are not allowed")
else()
    set(expected_code 2)
    if(CASE STREQUAL "unknown_option")
        set(arguments --unknown)
        set(expected_error "unknown or misplaced option")
    elseif(CASE STREQUAL "unknown_command")
        set(arguments unknown)
        set(expected_error "unexpected argument 'unknown'")
    elseif(CASE STREQUAL "extra_argument")
        set(arguments list build)
        set(expected_error "unexpected argument 'build'")
    elseif(CASE STREQUAL "duplicate_command")
        set(arguments list list)
        set(expected_error "unexpected argument 'list'")
    elseif(CASE STREQUAL "missing_file_argument")
        set(arguments list --file)
        set(expected_error "--file requires a path")
    elseif(CASE STREQUAL "empty_file_argument")
        # Preserve an empty argument explicitly at the execute_process call below.
        set(arguments)
        set(expected_error "--file requires a path")
    elseif(CASE STREQUAL "option_as_file")
        set(arguments list --file --help)
        set(expected_error "--file requires a path")
    elseif(CASE STREQUAL "duplicate_file")
        set(arguments --file "${config}" list --file "${config}")
        set(expected_error "--file may only be supplied once")
    elseif(CASE STREQUAL "missing_command")
        set(arguments --file "${config}")
        set(expected_error "expected 'list'")
    elseif(CASE STREQUAL "misplaced_help")
        set(arguments list --help)
        set(expected_error "unknown or misplaced option")
    elseif(CASE STREQUAL "misplaced_version")
        set(arguments list --version)
        set(expected_error "unknown or misplaced option")
    else()
        message(FATAL_ERROR "Unknown test case: ${CASE}")
    endif()
endif()

file(WRITE "${config}" "${source}")
if(CASE STREQUAL "plan_empty_target")
    execute_process(COMMAND "${TATR}" plan ""
        WORKING_DIRECTORY "${working_directory}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 10)
elseif(CASE STREQUAL "empty_file_argument")
    execute_process(COMMAND "${TATR}" --file "" list
        WORKING_DIRECTORY "${working_directory}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 10)
else()
    execute_process(COMMAND "${TATR}" ${arguments}
        WORKING_DIRECTORY "${working_directory}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 10)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
assert_no_sanitizer_diagnostic("${output}" "${error}")
if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "${CASE}: expected exit ${expected_code}, got ${code}\n${output}\n${error}")
endif()
if(expected_code EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "${CASE}: unexpected stderr: ${error}")
    endif()
    if(expected_output STREQUAL "__HELP__")
        if(NOT output MATCHES "Usage:" OR NOT output MATCHES "tatr.*list")
            message(FATAL_ERROR "${CASE}: missing usage information: ${output}")
        endif()
    elseif(NOT output STREQUAL expected_output)
        message(FATAL_ERROR "${CASE}: expected [${expected_output}], got [${output}]")
    endif()
else()
    if(NOT output STREQUAL "")
        message(FATAL_ERROR "${CASE}: error produced partial stdout: ${output}")
    endif()
    string(FIND "${error}" "${expected_error}" found)
    if(found EQUAL -1 OR NOT error MATCHES "^tatr: ")
        message(FATAL_ERROR "${CASE}: expected error containing [${expected_error}], got [${error}]")
    endif()
endif()
