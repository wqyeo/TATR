cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(config "${TEST_ROOT}/tatr.toml")
set(log "${TEST_ROOT}/ran.log")
file(REMOVE "${log}")
set(command "'${CHILD}', 'args', 'configured'")
set(arguments run target -- runtime)
set(expected_code 0)
set(expected_output "")
set(expected_error "")
set(expected_log "")
set(before "")
set(after "")
set(extra "")

function(expect_argument value)
    string(HEX "${value}" encoded)
    string(APPEND expected_output "[${encoded}]\n")
    set(expected_output "${expected_output}" PARENT_SCOPE)
endfunction()
expect_argument(configured)
expect_argument(runtime)

if(CASE STREQUAL "append_order")
    set(arguments run target -- first second)
    set(expected_output "")
    expect_argument(configured)
    expect_argument(first)
    expect_argument(second)
elseif(CASE STREQUAL "no_separator" OR CASE STREQUAL "empty_separator")
    set(arguments run target)
    if(CASE STREQUAL "empty_separator")
        list(APPEND arguments --)
    endif()
    set(expected_output "")
    expect_argument(configured)
elseif(CASE STREQUAL "empty_values")
    set(expected_output "")
    expect_argument(configured)
    expect_argument("")
    expect_argument(middle)
    expect_argument("")
elseif(CASE STREQUAL "encoding")
    set(expected_output "")
    expect_argument(configured)
    expect_argument("two words")
    expect_argument([=[a"b]=])
    expect_argument([=[tail\]=])
    expect_argument([=[space tail\]=])
    expect_argument([=[a\"b]=])
    expect_argument([=[a\\"b]=])
    expect_argument("测试 café")
    expect_argument("semi;colon")
    expect_argument("'single'")
    expect_argument("tab\tline\n")
elseif(CASE STREQUAL "literal")
    set(arguments run target -- "$HOME" "%PATH%" "$(echo nope)" "*" "a|b" "x>y")
    set(expected_output "")
    expect_argument(configured)
    expect_argument("$HOME")
    expect_argument("%PATH%")
    expect_argument("$(echo nope)")
    expect_argument("*")
    expect_argument("a|b")
    expect_argument("x>y")
elseif(CASE STREQUAL "flags_after_separator")
    set(arguments run target -- --file missing.toml --help --version --)
    set(expected_output "")
    expect_argument(configured)
    expect_argument(--file)
    expect_argument(missing.toml)
    expect_argument(--help)
    expect_argument(--version)
    expect_argument(--)
elseif(CASE MATCHES "^file_")
    if(NOT CASE STREQUAL "file_value_separator")
        # Default config is deliberately invalid, so only selected-file parsing works.
        file(WRITE "${config}" "invalid = [")
        set(config "${TEST_ROOT}/配置 with spaces.toml")
    endif()
    if(CASE STREQUAL "file_before")
        set(arguments --file "${config}" run target -- runtime)
    elseif(CASE STREQUAL "file_middle")
        set(arguments run --file "${config}" target -- runtime)
    elseif(CASE STREQUAL "file_after_target")
        set(arguments run target --file "${config}" -- runtime)
    else()
        set(arguments run target --file -- runtime)
        set(expected_code 2)
        set(expected_output "")
        set(expected_error "--file requires a path")
    endif()
elseif(CASE STREQUAL "prerequisite_isolation")
    set(after "depends = ['zeta', 'alpha']\n")
    set(before "[tasks.zeta]\nexec = ['${CHILD}', 'record', '${log}', 'zeta']\ndepends = ['shared']\n[tasks.alpha]\nexec = ['${CHILD}', 'record', '${log}', 'alpha']\ndepends = ['shared']\n[tasks.shared]\nexec = ['${CHILD}', 'record', '${log}', 'shared']\n")
    set(expected_log "shared\nzeta\nalpha\n")
elseif(CASE MATCHES "^grouping_")
    set(command "")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'record', '${log}', 'before']\n")
    set(after "depends = ['before']\n")
    set(expected_output "")
    if(CASE STREQUAL "grouping_empty_separator")
        set(arguments run target --)
        set(expected_log "before\n")
    else()
        set(expected_code 2)
        set(expected_error "cannot pass runtime arguments to a grouping task")
    endif()
elseif(CASE STREQUAL "cwd" OR CASE STREQUAL "env")
    set(command "'${CHILD}'")
    if(CASE STREQUAL "cwd")
        file(MAKE_DIRECTORY "${TEST_ROOT}/work")
        set(after "cwd = 'work'\n")
        set(arguments run target -- cwd)
        set(expected_output "${TEST_ROOT}/work\n")
    else()
        set(after "env = { TATR_TEST_ARGUMENTS = 'target only' }\n")
        set(arguments run target -- env_value TATR_TEST_ARGUMENTS)
        set(expected_output "value:target only\n")
    endif()
elseif(CASE MATCHES "^(child_failure|prerequisite_failure|launch_failure|combined_command_limit)$")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'record', '${log}', 'before']\n")
    set(after "depends = ['before']\n")
    set(expected_log "before\n")
    set(expected_output "")
    if(CASE STREQUAL "child_failure")
        set(command "'${CHILD}'")
        set(arguments run target -- exit 7)
        set(expected_code 1)
        set(expected_error "task 'target': exited with status 7")
    elseif(CASE STREQUAL "prerequisite_failure")
        string(APPEND before "[tasks.failure]\nexec = ['${CHILD}', 'exit', '7']\n[tasks.after]\nexec = ['${CHILD}', 'record', '${log}', 'after']\n")
        set(after "depends = ['before', 'failure', 'after']\n")
        set(expected_code 1)
        set(expected_error "task 'failure': exited with status 7")
    elseif(CASE STREQUAL "launch_failure")
        set(command "'${TEST_ROOT}/does-not-exist'")
        set(expected_code 2)
        set(expected_error "task 'target': cannot launch process")
    else()
        # Each input alone fits. Only the final configured + runtime command is
        # oversized, so TATR itself can still be launched by the test harness.
        string(REPEAT x 32000 configured)
        string(REPEAT y 1000 runtime)
        set(command "'${CHILD}', 'args', '${configured}'")
        set(arguments run target -- "${runtime}")
        set(expected_code 2)
        set(expected_error "command line exceeds Windows size limit")
    endif()
else()
    set(expected_code 2)
    set(expected_output "")
    set(expected_error "argument separator requires 'run TASK'")
    if(CASE STREQUAL "separator_no_target")
        set(arguments run -- runtime)
    elseif(CASE STREQUAL "separator_before_command")
        set(arguments -- run target)
    elseif(CASE STREQUAL "list_separator")
        set(arguments list -- runtime)
    elseif(CASE STREQUAL "plan_separator")
        set(arguments plan target -- runtime)
    elseif(CASE STREQUAL "empty_target")
        # Preserved explicitly at invocation below.
    elseif(CASE STREQUAL "extra_before_separator")
        set(arguments run target extra -- runtime)
        set(expected_error "unexpected argument 'extra'")
    elseif(CASE STREQUAL "extra_without_separator")
        set(arguments run target runtime)
        set(expected_error "unexpected argument 'runtime'")
    elseif(CASE STREQUAL "unknown_target")
        set(arguments run absent -- runtime)
        set(expected_error "unknown task 'absent'")
    elseif(CASE STREQUAL "invalid_unrelated")
        set(extra "[tasks.invalid]\nexec = ['${CHILD}']\nenv = { BAD = 42 }\n")
        set(expected_error "task 'invalid'.env:")
    else()
        message(FATAL_ERROR "Unknown runtime argument test: ${CASE}")
    endif()
endif()

set(source "version = 1\n${before}[tasks.target]\n")
if(NOT command STREQUAL "")
    string(APPEND source "exec = [${command}]\n")
endif()
string(APPEND source "${after}${extra}")
# These process/config regression cases opt out of action records; logging has its own suite.
file(WRITE "${config}" "${source}\n[logging]\nlevel = 'off'\n")

# Literal invocations preserve empty arguments and embedded semicolons, which
# CMake list expansion would otherwise discard or split.
if(CASE STREQUAL "empty_values")
    execute_process(COMMAND "${TATR}" run target -- "" middle ""
        WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
elseif(CASE STREQUAL "encoding")
    execute_process(COMMAND "${TATR}" run target -- "two words" [=[a"b]=] [=[tail\]=]
        [=[space tail\]=] [=[a\"b]=] [=[a\\"b]=] "测试 café" "semi;colon" "'single'" "tab\tline\n"
        WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
elseif(CASE STREQUAL "empty_target")
    execute_process(COMMAND "${TATR}" run "" -- runtime
        WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
elseif(CASE STREQUAL "grouping_empty_argument")
    execute_process(COMMAND "${TATR}" run target -- ""
        WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
else()
    execute_process(COMMAND "${TATR}" ${arguments}
        WORKING_DIRECTORY "${TEST_ROOT}" RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
endif()
assert_no_sanitizer_diagnostic("${output}" "${error}")
if(CASE STREQUAL "cwd")
    string(REPLACE "\\" "/" output "${output}")
endif()
if(NOT "${code}" STREQUAL "${expected_code}" OR NOT output STREQUAL expected_output)
    message(FATAL_ERROR "${CASE}: expected ${expected_code} [${expected_output}], got ${code} [${output}] ${error}")
endif()
if(expected_code EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "${CASE}: unexpected stderr: ${error}")
    endif()
else()
    string(FIND "${error}" "${expected_error}" found)
    if(found EQUAL -1 OR NOT error MATCHES "^tatr: ")
        message(FATAL_ERROR "${CASE}: expected [${expected_error}], got ${error}")
    endif()
endif()
if(EXISTS "${log}")
    file(READ "${log}" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT actual STREQUAL expected_log)
        message(FATAL_ERROR "${CASE}: unexpected prerequisite effects: ${actual}")
    endif()
elseif(NOT expected_log STREQUAL "")
    message(FATAL_ERROR "${CASE}: prerequisite effects missing")
endif()
