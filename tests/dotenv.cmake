cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
file(MAKE_DIRECTORY "${TEST_ROOT}/config" "${TEST_ROOT}/caller" "${TEST_ROOT}/work")
set(config "${TEST_ROOT}/config/tatr.toml")
set(file "${TEST_ROOT}/config/values.env")
set(file_field "'values.env'")
set(content "TATR_TEST_DOTENV=file value\n")
set(command "'${CHILD}', 'env_value', 'TATR_TEST_DOTENV'")
set(inline "")
set(before "")
set(after "")
set(extra "")
set(log "${TEST_ROOT}/ran.log")
file(REMOVE "${log}")
set(arguments --file "${config}" run target)
set(expected_code 0)
set(expected_output "value:file value\n")
set(expected_error "")
set(expected_log "")
set(write_file ON)
set(exact_write OFF)
set(ENV{TATR_TEST_DOTENV} inherited)

if(CASE STREQUAL "basic")
    # Defaults load a path relative to TOML, not the caller's directory.
elseif(CASE STREQUAL "inherited")
    set(content "OTHER=value\n")
    set(expected_output "value:inherited\n")
elseif(CASE STREQUAL "inline_precedence")
    set(inline "{ TATR_TEST_DOTENV = 'inline value' }")
    set(expected_output "value:inline value\n")
elseif(CASE STREQUAL "inline_empty")
    set(inline "{ TATR_TEST_DOTENV = '' }")
    set(expected_output "value:\n")
elseif(CASE STREQUAL "empty_file")
    set(content "")
    set(expected_output "value:inherited\n")
elseif(CASE STREQUAL "empty_value")
    set(content "TATR_TEST_DOTENV=\n")
    set(expected_output "value:\n")
elseif(CASE STREQUAL "whitespace")
    set(content " \tTATR_TEST_DOTENV \t= \ttwo  words \t\n")
    set(expected_output "value:two  words\n")
elseif(CASE STREQUAL "equals_value")
    set(content "TATR_TEST_DOTENV=a=b=c\n")
    set(expected_output "value:a=b=c\n")
elseif(CASE STREQUAL "comment")
    set(content "TATR_TEST_DOTENV=value # ignored\n")
    set(expected_output "value:value\n")
elseif(CASE STREQUAL "full_comments")
    set(content "\n \t# comment\nTATR_TEST_DOTENV=# empty\n")
    set(expected_output "value:\n")
elseif(CASE STREQUAL "hash_literal")
    set(content "TATR_TEST_DOTENV=value#literal\n")
    set(expected_output "value:value#literal\n")
elseif(CASE STREQUAL "hash_quoted")
    set(content "TATR_TEST_DOTENV=\"# literal\"# comment\n")
    set(expected_output "value:# literal\n")
elseif(CASE STREQUAL "single_quotes")
    set(content [=[TATR_TEST_DOTENV='C:\tools\new $HOME # literal']=])
    set(expected_output "value:C:\\tools\\new $HOME # literal\n")
elseif(CASE STREQUAL "double_quotes")
    set(content "TATR_TEST_DOTENV=\"测试 café 😀 with spaces\" \t# comment\n")
    set(expected_output "value:测试 café 😀 with spaces\n")
elseif(CASE STREQUAL "escapes")
    set(content [=[TATR_TEST_DOTENV="line\nnext\ttab\rreturn\\slash\"quote"]=])
    # execute_process normalizes CRLF only; an isolated CR remains part of output.
    string(ASCII 13 carriage_return)
    set(expected_output "value:line\nnext\ttab${carriage_return}return\\slash\"quote\n")
elseif(CASE STREQUAL "literal")
    set(content [=[TATR_TEST_DOTENV=$HOME %PATH% $(echo nope) ${OTHER}]=])
    set(expected_output [=[value:$HOME %PATH% $(echo nope) ${OTHER}
]=])
elseif(CASE STREQUAL "unquoted_quotes")
    set(content [=[TATR_TEST_DOTENV=a"b'c]=])
    set(expected_output "value:a\"b'c\n")
elseif(CASE STREQUAL "export_prefix")
    set(content " \texport\tTATR_TEST_DOTENV=exported\n")
    set(expected_output "value:exported\n")
elseif(CASE STREQUAL "export_name")
    set(content "exportNAME=literal name\n")
    set(command "'${CHILD}', 'env_value', 'exportNAME'")
    set(expected_output "value:literal name\n")
elseif(CASE STREQUAL "crlf")
    set(content "# comment\r\nTATR_TEST_DOTENV=CRLF\r\n")
    set(expected_output "value:CRLF\n")
elseif(CASE STREQUAL "bom")
    string(ASCII 239 187 191 bom)
    set(content "${bom}TATR_TEST_DOTENV=BOM\n")
    set(expected_output "value:BOM\n")
elseif(CASE STREQUAL "no_final_newline")
    set(content "TATR_TEST_DOTENV=no final newline")
    set(expected_output "value:no final newline\n")
elseif(CASE STREQUAL "absolute_file")
    set(file_field "'${file}'")
elseif(CASE STREQUAL "unicode_file")
    set(file "${TEST_ROOT}/config/环境 café with spaces.env")
    set(file_field "'环境 café with spaces.env'")
elseif(CASE STREQUAL "relative_config")
    set(arguments --file ../config/tatr.toml run target)
elseif(CASE STREQUAL "cwd_independent")
    set(after "cwd = '../work'\n")
    file(WRITE "${TEST_ROOT}/work/values.env" "TATR_TEST_DOTENV=wrong directory\n")
elseif(CASE STREQUAL "generated_file")
    string(RANDOM LENGTH 10 ALPHABET abcdef0123456789 token)
    set(file "${TEST_ROOT}/config/generated-${token}.env")
    set(file_field "'generated-${token}.env'")
    set(write_file OFF)
    file(WRITE "${TEST_ROOT}/template.env" "TATR_TEST_DOTENV=generated\n")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'copy_file', '${TEST_ROOT}/template.env', '${file}']\n")
    set(after "depends = ['before']\n")
    set(expected_output "value:generated\n")
elseif(CASE STREQUAL "isolation")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'env_value', 'TATR_TEST_DOTENV']\nenv_file = 'values.env'\n")
    set(file_field "")
    set(after "depends = ['before']\n")
    set(expected_output "value:file value\nvalue:inherited\n")
elseif(CASE STREQUAL "no_discovery")
    set(file "${TEST_ROOT}/config/.env")
    set(file_field "")
    set(expected_output "value:inherited\n")
elseif(CASE MATCHES "^(list_missing|plan_missing|list_malformed|unrelated_missing)$")
    if(CASE STREQUAL "list_malformed")
        set(content "INVALID SECRET_VALUE_DO_NOT_PRINT\n")
    else()
        set(write_file OFF)
        set(file_field "'never-created.env'")
    endif()
    set(expected_output "target\n")
    if(CASE STREQUAL "plan_missing")
        set(arguments --file "${config}" plan target)
    elseif(CASE STREQUAL "unrelated_missing")
        set(extra "[tasks.safe]\n")
        set(arguments --file "${config}" run safe)
        set(expected_output "")
    else()
        set(arguments --file "${config}" list)
    endif()
elseif(CASE STREQUAL "path_file" OR CASE STREQUAL "path_inline" OR CASE STREQUAL "path_empty")
    if(WIN32)
        set(suffix .exe)
    else()
        set(suffix "")
    endif()
    file(MAKE_DIRECTORY "${TEST_ROOT}/work/bin")
    set(probe "${TEST_ROOT}/work/bin/dotenv-probe${suffix}")
    file(COPY_FILE "${CHILD}" "${probe}" ONLY_IF_DIFFERENT)
    if(UNIX)
        file(CHMOD "${probe}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    endif()
    set(command "'dotenv-probe', 'env_value', 'TATR_TEST_DOTENV'")
    set(after "cwd = '../work'\n")
    set(content "PATH=bin\nTATR_TEST_DOTENV=file value\n")
    set(ENV{PATH} "${TEST_ROOT}/absent")
    if(CASE STREQUAL "path_inline")
        set(content "PATH=missing\nTATR_TEST_DOTENV=file value\n")
        set(inline "{ PATH = 'bin' }")
    elseif(CASE STREQUAL "path_empty")
        file(COPY_FILE "${probe}" "${TEST_ROOT}/work/dotenv-probe${suffix}" ONLY_IF_DIFFERENT)
        if(UNIX)
            file(CHMOD "${TEST_ROOT}/work/dotenv-probe${suffix}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        endif()
        set(content "PATH=\nTATR_TEST_DOTENV=file value\n")
    endif()
elseif(CASE STREQUAL "windows_layer_casing")
    set(content "tatr_test_dotenv=file value\n")
    set(inline "{ TATR_TEST_DOTENV = 'inline case override' }")
    set(expected_output "value:inline case override\n")
elseif(CASE STREQUAL "size_limit" OR CASE STREQUAL "size_over_limit")
    set(exact_write ON)
    set(content "TATR_TEST_DOTENV=file value\n#")
    string(LENGTH "${content}" length)
    math(EXPR padding "1048576 - ${length} - 1")
    if(CASE STREQUAL "size_over_limit")
        math(EXPR padding "${padding} + 1")
        set(expected_code 2)
        set(expected_output "")
        set(expected_error "environment file exceeds 1 MiB limit")
    endif()
    string(REPEAT x ${padding} padding_text)
    string(APPEND content "${padding_text}\n")
else()
    set(expected_code 2)
    set(expected_output "")
    set(expected_error "values.env:")
    if(CASE STREQUAL "duplicate")
        set(content "TATR_TEST_DOTENV=SECRET_VALUE_DO_NOT_PRINT\nTATR_TEST_DOTENV=second\n")
        set(expected_error "values.env:2: duplicate")
    elseif(CASE STREQUAL "case_variants")
        set(content "TATR_TEST_DOTENV=upper\ntatr_test_dotenv=lower\n")
        if(WIN32)
            set(expected_error "values.env:2: duplicate")
        else()
            set(expected_code 0)
            set(expected_output "value:upper\n")
        endif()
    elseif(CASE STREQUAL "malformed")
        set(content "MALFORMED SECRET_VALUE_DO_NOT_PRINT\n")
        set(expected_error "values.env:1: expected NAME=value")
    elseif(CASE STREQUAL "unknown_escape")
        set(content [=[TATR_TEST_DOTENV="SECRET_VALUE_DO_NOT_PRINT\q"]=])
        set(expected_error "unsupported double-quote escape")
    elseif(CASE STREQUAL "unclosed_quote")
        set(content "TATR_TEST_DOTENV='SECRET_VALUE_DO_NOT_PRINT\n")
        set(expected_error "unterminated quoted")
    elseif(CASE STREQUAL "trailing_text")
        set(content "TATR_TEST_DOTENV='secret' SECRET_VALUE_DO_NOT_PRINT\n")
        set(expected_error "unexpected text after quoted")
    elseif(CASE STREQUAL "multiline")
        set(content "TATR_TEST_DOTENV=\"first\nSECRET_VALUE_DO_NOT_PRINT\"\n")
        set(expected_error "physical multiline")
    elseif(CASE MATCHES "^name_")
        set(name "")
        if(CASE STREQUAL "name_digit")
            set(name 1BAD)
        elseif(CASE STREQUAL "name_dash")
            set(name BAD-NAME)
        elseif(CASE STREQUAL "name_unicode")
            set(name 变量)
        endif()
        set(content "${name}=SECRET_VALUE_DO_NOT_PRINT\n")
        set(expected_error "environment variable names must match")
    elseif(CASE MATCHES "^(nul_value|invalid_utf8|invalid_continuation|overlong_utf8|surrogate_utf8|high_utf8|truncated_utf8)$")
        # Append binary bytes with a tiny test helper after writing the text prefix.
        set(content "TATR_TEST_DOTENV=SECRET_VALUE_DO_NOT_PRINT")
        if(CASE STREQUAL "nul_value")
            set(binary 00)
            set(expected_error "NUL is not allowed")
        elseif(CASE STREQUAL "invalid_utf8")
            set(binary ff)
        elseif(CASE STREQUAL "invalid_continuation")
            set(binary e228a1)
        elseif(CASE STREQUAL "overlong_utf8")
            set(binary e08080)
        elseif(CASE STREQUAL "surrogate_utf8")
            set(binary eda080)
        elseif(CASE STREQUAL "high_utf8")
            set(binary f4908080)
        else()
            set(binary f09f)
        endif()
        if(NOT CASE STREQUAL "nul_value")
            set(expected_error "must contain valid UTF-8")
        endif()
    elseif(CASE STREQUAL "lone_cr")
        set(content "TATR_TEST_DOTENV=first\rOTHER=SECRET_VALUE_DO_NOT_PRINT\n")
        set(expected_error "expected LF or CRLF")
    elseif(CASE STREQUAL "bare_trailing_cr")
        set(content "TATR_TEST_DOTENV=SECRET_VALUE_DO_NOT_PRINT\r")
        set(expected_error "expected LF or CRLF")
    elseif(CASE STREQUAL "error_line")
        set(content "# comment\nGOOD=value\nMALFORMED SECRET_VALUE_DO_NOT_PRINT\n")
        set(expected_error "values.env:3:")
    elseif(CASE STREQUAL "missing" OR CASE STREQUAL "not_file")
        set(write_file OFF)
        if(CASE STREQUAL "not_file")
            file(MAKE_DIRECTORY "${file}")
        else()
            set(file_field "'missing.env'")
        endif()
        set(expected_error "cannot read environment file")
        set(before "[tasks.before]\nexec = ['${CHILD}', 'record', '${log}', 'before']\n")
        set(after "depends = ['before']\n")
        set(expected_log "before\n")
    elseif(CASE STREQUAL "inline_does_not_hide_error")
        set(content "TATR_TEST_DOTENV='SECRET_VALUE_DO_NOT_PRINT\n")
        set(inline "{ TATR_TEST_DOTENV = 'inline value' }")
        set(expected_error "unterminated quoted")
    elseif(CASE MATCHES "^(type_number|type_array|empty_path|nul_path|grouping|invalid_unrelated|drive_relative)$")
        set(expected_error "task 'target'.env_file:")
        if(CASE STREQUAL "type_number")
            set(file_field 42)
        elseif(CASE STREQUAL "type_array")
            set(file_field "[]")
        elseif(CASE STREQUAL "empty_path")
            set(file_field "''")
        elseif(CASE STREQUAL "nul_path")
            set(file_field [=["bad\u0000path"]=])
        elseif(CASE STREQUAL "grouping")
            set(command "")
        elseif(CASE STREQUAL "drive_relative")
            set(file_field "'C:values.env'")
            set(expected_error "drive-relative paths")
        else()
            set(extra "[tasks.invalid]\nexec = ['${CHILD}']\nenv_file = []\n")
            set(expected_error "task 'invalid'.env_file:")
        endif()
    else()
        message(FATAL_ERROR "Unknown dotenv fixture: ${CASE}")
    endif()
endif()

if(write_file)
    if(exact_write)
        file(CONFIGURE OUTPUT "${file}" CONTENT "${content}" @ONLY NEWLINE_STYLE UNIX)
        file(SIZE "${file}" actual_size)
        if((CASE STREQUAL "size_limit" AND NOT actual_size EQUAL 1048576) OR
           (CASE STREQUAL "size_over_limit" AND NOT actual_size EQUAL 1048577))
            message(FATAL_ERROR "Incorrect dotenv boundary size: ${actual_size}")
        endif()
    else()
        # The helper writes exact bytes, preserving requested LF/CRLF/EOF forms
        # even when this fixture is driven by Windows CMake.
        string(HEX "${content}" text_hex)
        execute_process(COMMAND "${CHILD}" write_hex "${file}" "${text_hex}"
            RESULT_VARIABLE write_code ERROR_VARIABLE write_error TIMEOUT 15)
        if(NOT "${write_code}" STREQUAL "0")
            message(FATAL_ERROR "Cannot write dotenv fixture: ${write_code} ${write_error}")
        endif()
    endif()
    if(DEFINED binary)
        execute_process(COMMAND "${CHILD}" append_hex "${file}" "${binary}"
            RESULT_VARIABLE write_code ERROR_VARIABLE write_error TIMEOUT 15)
        if(NOT "${write_code}" STREQUAL "0")
            message(FATAL_ERROR "Cannot append binary fixture: ${write_code} ${write_error}")
        endif()
    endif()
endif()
set(source "version = 1\n${before}[tasks.target]\n")
if(NOT command STREQUAL "")
    string(APPEND source "exec = [${command}]\n")
endif()
if(NOT file_field STREQUAL "")
    string(APPEND source "env_file = ${file_field}\n")
endif()
if(NOT inline STREQUAL "")
    string(APPEND source "env = ${inline}\n")
endif()
string(APPEND source "${after}${extra}")
# These process/config regression cases opt out of action records; logging has its own suite.
file(WRITE "${config}" "${source}\n[logging]\nlevel = 'off'\n")
execute_process(COMMAND "${TATR}" ${arguments} WORKING_DIRECTORY "${TEST_ROOT}/caller"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
assert_no_sanitizer_diagnostic("${output}" "${error}")
if(NOT "${code}" STREQUAL "${expected_code}" OR NOT output STREQUAL expected_output)
    message(FATAL_ERROR "${CASE}: expected ${expected_code} [${expected_output}], got ${code} [${output}] ${error}")
endif()
if(error MATCHES "SECRET_VALUE_DO_NOT_PRINT")
    message(FATAL_ERROR "${CASE}: environment content leaked into a diagnostic")
endif()
if(expected_code EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "${CASE}: unexpected stderr: ${error}")
    endif()
else()
    string(FIND "${error}" "${expected_error}" found)
    if(found EQUAL -1 OR NOT error MATCHES "^tatr: ")
        message(FATAL_ERROR "${CASE}: expected [${expected_error}], got ${error}")
    endif()
endif()
if(EXISTS "${log}")
    file(READ "${log}" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT actual STREQUAL expected_log)
        message(FATAL_ERROR "${CASE}: unexpected side effects: ${actual}")
    endif()
elseif(NOT expected_log STREQUAL "")
    message(FATAL_ERROR "${CASE}: expected prerequisite side effect missing")
endif()
