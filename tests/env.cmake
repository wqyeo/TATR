cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
file(MAKE_DIRECTORY "${TEST_ROOT}/caller" "${TEST_ROOT}/work/bin" "${TEST_ROOT}/old-bin")
set(config "${TEST_ROOT}/tatr.toml")
set(caller "${TEST_ROOT}/caller")
set(work "${TEST_ROOT}/work")
set(log "${TEST_ROOT}/ran.log")
file(REMOVE "${log}")
set(ENV{TATR_TEST_ENV} "inherited")
unset(ENV{TATR_TEST_NEW})
set(command "'${CHILD}', 'env_value', 'TATR_TEST_ENV'")
set(env "{ TATR_TEST_ENV = 'overridden' }")
set(directory "")
set(before "")
set(after "")
set(extra "")
set(arguments --file "${config}" run target)
set(expected_code 0)
set(expected_output "value:overridden\n")
set(expected_error "")
set(expected_log "")

if(CASE STREQUAL "inherit")
    set(env "{ OTHER = 'something' }")
    set(expected_output "value:inherited\n")
elseif(CASE STREQUAL "replace")
    # Defaults replace an inherited value.
elseif(CASE STREQUAL "empty")
    set(env "{ TATR_TEST_ENV = '' }")
    set(expected_output "value:\n")
elseif(CASE STREQUAL "unicode")
    set(env "{ TATR_TEST_ENV = '测试 café with spaces' }")
    set(expected_output "value:测试 café with spaces\n")
elseif(CASE STREQUAL "literal")
    set(env [=[{ TATR_TEST_ENV = '$HOME %PATH% $(echo nope) * a=b' }]=])
    set(expected_output "value:$HOME %PATH% $(echo nope) * a=b\n")
elseif(CASE STREQUAL "new_name")
    set(command "'${CHILD}', 'env_value', 'TATR_TEST_NEW'")
    set(env "{ TATR_TEST_NEW = 'new' }")
    set(expected_output "value:new\n")
elseif(CASE STREQUAL "empty_table")
    set(env "{}")
    set(expected_output "value:inherited\n")
elseif(CASE STREQUAL "isolation")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'env_value', 'TATR_TEST_ENV']\nenv = { TATR_TEST_ENV = 'first' }\n")
    set(after "depends = ['before']\n")
    set(env "")
    set(expected_output "value:first\nvalue:inherited\n")
elseif(CASE STREQUAL "inherited_unusual_name")
    set(ENV{变量} "native value")
    set(command "'${CHILD}', 'env_value', '变量'")
    set(expected_output "value:native value\n")
elseif(CASE STREQUAL "inherited_path_unset")
    unset(ENV{PATH})
elseif(CASE MATCHES "^(path_|lookup_preserved|windows_path_casing)")
    if(WIN32)
        set(suffix .exe)
        set(separator ";")
    else()
        set(suffix "")
        set(separator ":")
    endif()
    set(probe "${work}/bin/env-probe${suffix}")
    file(COPY_FILE "${CHILD}" "${probe}" ONLY_IF_DIFFERENT)
    if(UNIX)
        file(CHMOD "${probe}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    endif()
    file(COPY_FILE "${probe}" "${TEST_ROOT}/old-bin/env-probe${suffix}" ONLY_IF_DIFFERENT)
    set(ENV{PATH} "${TEST_ROOT}/old-bin")
    set(command "'env-probe', 'env_value', 'TATR_TEST_ENV'")
    set(directory "${work}")
    set(search "${work}/bin")
    if(CASE STREQUAL "path_relative")
        set(search bin)
    elseif(CASE STREQUAL "path_without_cwd")
        set(directory "")
    elseif(CASE STREQUAL "path_empty" OR CASE STREQUAL "path_empty_entry")
        file(COPY_FILE "${probe}" "${work}/env-probe${suffix}" ONLY_IF_DIFFERENT)
        if(UNIX)
            file(CHMOD "${work}/env-probe${suffix}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        endif()
        set(search "")
        if(CASE STREQUAL "path_empty_entry")
            set(search "${work}/absent${separator}")
        endif()
    elseif(CASE STREQUAL "path_missing")
        set(search "${work}/absent")
        set(expected_code 2)
        set(expected_output "")
        set(expected_error "cannot launch process")
    elseif(CASE STREQUAL "path_unicode")
        set(unicode_bin "${work}/工具 café")
        file(MAKE_DIRECTORY "${unicode_bin}")
        file(COPY_FILE "${probe}" "${unicode_bin}/env-probe${suffix}" ONLY_IF_DIFFERENT)
        if(UNIX)
            file(CHMOD "${unicode_bin}/env-probe${suffix}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        endif()
        set(search "${unicode_bin}")
    elseif(CASE STREQUAL "path_denied" OR CASE STREQUAL "path_continue")
        file(MAKE_DIRECTORY "${work}/denied")
        # Executing a directory yields EACCES even on host mounts that ignore
        # executable permission bits. Remove only the previous fixture's file.
        if(EXISTS "${work}/denied/env-probe" AND NOT IS_DIRECTORY "${work}/denied/env-probe")
            file(REMOVE "${work}/denied/env-probe")
        endif()
        file(MAKE_DIRECTORY "${work}/denied/env-probe")
        set(search "${work}/denied")
        if(CASE STREQUAL "path_continue")
            string(APPEND search ":${work}/bin")
        else()
            set(expected_code 2)
            set(expected_output "")
            set(expected_error "cannot launch process")
        endif()
    endif()
    if(CASE STREQUAL "windows_path_casing")
        set(path_name Path)
    else()
        set(path_name PATH)
    endif()
    set(env "{ ${path_name} = '${search}', TATR_TEST_ENV = 'overridden' }")
    if(CASE STREQUAL "lookup_preserved")
        set(env "{ TATR_TEST_ENV = 'overridden' }")
    endif()
elseif(CASE STREQUAL "list_readonly" OR CASE STREQUAL "plan_readonly")
    set(expected_output "target\n")
    if(CASE STREQUAL "list_readonly")
        set(arguments --file "${config}" list)
    else()
        set(arguments --file "${config}" plan target)
    endif()
elseif(CASE STREQUAL "windows_casing")
    set(env "{ tatr_test_env = 'lower case override' }")
    set(expected_output "value:lower case override\n")
elseif(CASE STREQUAL "case_variants")
    set(env "{ MODE = 'upper', mode = 'lower' }")
    set(command "'${CHILD}', 'env_value', 'MODE'")
    if(WIN32)
        set(expected_code 2)
        set(expected_output "")
        set(expected_error "conflicting environment variable names")
    else()
        set(expected_output "value:upper\n")
    endif()
elseif(CASE MATCHES "^(launch_failure|child_failure|size_failure|no_shell_fallback)$")
    set(before "[tasks.before]\nexec = ['${CHILD}', 'record', '${log}', 'before']\n")
    set(after "depends = ['before']\n")
    set(extra "[tasks.later]\nexec = ['${CHILD}', 'record', '${log}', 'later']\ndepends = ['target']\n")
    set(arguments --file "${config}" run later)
    set(expected_log "before\n")
    set(expected_code 2)
    set(expected_output "")
    set(expected_error "cannot launch process")
    if(CASE STREQUAL "launch_failure")
        set(command "'${work}/does-not-exist'")
    elseif(CASE STREQUAL "child_failure")
        set(command "'${CHILD}', 'exit', '7'")
        set(expected_code 1)
        set(expected_error "task 'target': exited with status 7")
    elseif(CASE STREQUAL "size_failure")
        if(WIN32)
            set(length 33000)
            set(expected_error "environment entry exceeds Windows size limit")
        else()
            set(length 140000)
        endif()
        string(REPEAT x ${length} oversized)
        set(env "{ TATR_TEST_ENV = '${oversized}' }")
    else()
        if(WIN32)
            set(script "${work}/env-script.cmd")
            file(WRITE "${script}" "@echo should-not-run\n")
        else()
            set(script "${work}/env-script")
            file(WRITE "${script}" "echo should-not-run\n")
            file(CHMOD "${script}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
        endif()
        set(command "'${script}'")
        set(env "{ PATH = '${work}' }")
    endif()
else()
    set(expected_code 2)
    set(expected_output "")
    set(expected_error "task 'target'.env:")
    if(CASE STREQUAL "invalid_unrelated")
        set(extra "[tasks.invalid]\nexec = ['${CHILD}']\nenv = { BAD = 42 }\n")
        set(expected_error "task 'invalid'.env:")
    elseif(CASE STREQUAL "grouping")
        set(command "")
        set(env "{}")
        set(expected_error "requires an executable task")
    elseif(CASE STREQUAL "type_string")
        set(env "'DO_NOT_LOG_THIS_VALUE'")
    elseif(CASE STREQUAL "type_array")
        set(env "['DO_NOT_LOG_THIS_VALUE']")
    elseif(CASE STREQUAL "type_number")
        set(env 42)
    elseif(CASE STREQUAL "nul_value")
        set(env [=[{ VALUE = "DO_NOT_LOG_THIS_VALUE\u0000" }]=])
    elseif(CASE MATCHES "^value_")
        if(CASE STREQUAL "value_number")
            set(value 42)
        elseif(CASE STREQUAL "value_boolean")
            set(value true)
        elseif(CASE STREQUAL "value_array")
            set(value "['DO_NOT_LOG_THIS_VALUE']")
        else()
            set(value "{ HIDDEN = 'DO_NOT_LOG_THIS_VALUE' }")
        endif()
        set(env "{ VALUE = ${value} }")
    elseif(CASE MATCHES "^name_")
        set(name "")
        if(CASE STREQUAL "name_digit")
            set(name 1NAME)
        elseif(CASE STREQUAL "name_equals")
            set(name BAD=NAME)
        elseif(CASE STREQUAL "name_dash")
            set(name BAD-NAME)
        elseif(CASE STREQUAL "name_unicode")
            set(name 变量)
        elseif(CASE STREQUAL "name_control")
            set(name [=[BAD\u001bNAME]=])
        elseif(CASE STREQUAL "name_nul")
            set(name [=[BAD\u0000NAME]=])
        endif()
        set(env "{ \"${name}\" = 'DO_NOT_LOG_THIS_VALUE' }")
    else()
        message(FATAL_ERROR "Unknown environment test: ${CASE}")
    endif()
endif()

set(source "version = 1\n${before}[tasks.target]\n")
if(NOT command STREQUAL "")
    string(APPEND source "exec = [${command}]\n")
endif()
if(NOT env STREQUAL "")
    string(APPEND source "env = ${env}\n")
endif()
if(NOT directory STREQUAL "")
    string(APPEND source "cwd = '${directory}'\n")
endif()
string(APPEND source "${after}${extra}")
file(WRITE "${config}" "${source}")
execute_process(COMMAND "${TATR}" ${arguments} WORKING_DIRECTORY "${caller}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 15)
assert_no_sanitizer_diagnostic("${output}" "${error}")
if(NOT "${code}" STREQUAL "${expected_code}" OR NOT output STREQUAL expected_output)
    message(FATAL_ERROR "${CASE}: expected ${expected_code} [${expected_output}], got ${code} [${output}] ${error}")
endif()
if(error MATCHES "DO_NOT_LOG_THIS_VALUE")
    message(FATAL_ERROR "${CASE}: environment value leaked into diagnostic")
endif()
if(expected_code EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "${CASE}: unexpected stderr: ${error}")
    endif()
else()
    string(FIND "${error}" "${expected_error}" found)
    if(found EQUAL -1 OR NOT error MATCHES "^tatr: ")
        message(FATAL_ERROR "${CASE}: expected [${expected_error}], got ${error}")
    endif()
endif()
if(EXISTS "${log}")
    file(READ "${log}" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT actual STREQUAL expected_log)
        message(FATAL_ERROR "${CASE}: unexpected child side effects: ${actual}")
    endif()
elseif(NOT expected_log STREQUAL "")
    message(FATAL_ERROR "${CASE}: prerequisite did not execute")
endif()
