cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(config "${TEST_ROOT}/tatr.toml")
set(log "${TEST_ROOT}/executed.log")
file(REMOVE "${log}")
set(source "version = 1\n[logging]\nlevel = 'off'\n[tasks.target]\nexec = ['${CHILD}', 'record', '${log}', 'ran']\n#")
string(LENGTH "${source}" length)
math(EXPR padding "1048576 - ${length} - 1")
string(REPEAT x ${padding} comment)
string(APPEND source "${comment}")
if(CASE STREQUAL "config_over_limit")
    string(APPEND source x)
    set(expected 2)
else()
    set(expected 0)
endif()
string(APPEND source "\n")
file(CONFIGURE OUTPUT "${config}" CONTENT "${source}" @ONLY NEWLINE_STYLE UNIX)
file(SIZE "${config}" actual_size)
if((expected EQUAL 0 AND NOT actual_size EQUAL 1048576) OR
   (expected EQUAL 2 AND NOT actual_size EQUAL 1048577))
    message(FATAL_ERROR "Incorrect boundary fixture size: ${actual_size}")
endif()
execute_process(COMMAND "${TATR}" --file "${config}" run target
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
include("${CMAKE_CURRENT_LIST_DIR}/assert-clean.cmake")
assert_no_sanitizer_diagnostic("${output}" "${error}")
if(NOT "${code}" STREQUAL "${expected}" OR NOT output STREQUAL "")
    message(FATAL_ERROR "${CASE}: unexpected result ${code}: ${output} ${error}")
endif()
if(expected EQUAL 0)
    if(NOT error STREQUAL "" OR NOT EXISTS "${log}")
        message(FATAL_ERROR "Boundary config failed: ${error}")
    endif()
    file(READ "${log}" actual)
    string(REPLACE "\r\n" "\n" actual "${actual}")
    if(NOT actual STREQUAL "ran\n")
        message(FATAL_ERROR "Boundary task did not execute as expected")
    endif()
elseif(EXISTS "${log}" OR NOT error MATCHES "configuration exceeds 1 MiB limit")
    message(FATAL_ERROR "Oversized config ran a task or lacked diagnostic: ${error}")
endif()
