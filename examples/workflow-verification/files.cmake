cmake_minimum_required(VERSION 3.25)
# Run only in a fresh disposable directory; no recursive cleanup is performed.
if(EXISTS "archive destination" OR EXISTS "extracted zip" OR EXISTS "extracted tar")
  message(FATAL_ERROR "Use a fresh fixture directory")
endif()
file(MAKE_DIRECTORY "source files/nested folder" "staging files" "archive destination")
file(WRITE "source files/nested folder/payload.txt" "portable payload\n")
file(WRITE "source files/empty.txt" "")
file(COPY "source files/" DESTINATION "staging files")
file(RENAME "staging files/nested folder/payload.txt" "staging files/nested folder/moved payload.txt")
foreach(format IN ITEMS zip tar)
  if(format STREQUAL "zip")
    set(archive "payload.zip")
    set(options cf "${archive}" --format=zip)
  else()
    set(archive "payload.tar.gz")
    set(options czf "${archive}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${options} "staging files"
    RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Archive failed: ${format}")
  endif()
  file(SHA256 "${archive}" before)
  file(RENAME "${archive}" "archive destination/${archive}")
  file(SHA256 "archive destination/${archive}" after)
  if(NOT before STREQUAL after OR EXISTS "${archive}")
    message(FATAL_ERROR "Move mismatch")
  endif()
  file(ARCHIVE_EXTRACT INPUT "archive destination/${archive}" DESTINATION "extracted ${format}")
  file(GLOB_RECURSE original LIST_DIRECTORIES false RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}/staging files" "staging files/*")
  file(GLOB_RECURSE restored LIST_DIRECTORIES false RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}/extracted ${format}/staging files" "extracted ${format}/staging files/*")
  if(NOT original STREQUAL restored)
    message(FATAL_ERROR "Archive member mismatch")
  endif()
  foreach(path IN LISTS original)
    file(SHA256 "staging files/${path}" expected)
    file(SHA256 "extracted ${format}/staging files/${path}" actual)
    if(NOT expected STREQUAL actual)
      message(FATAL_ERROR "Content mismatch: ${path}")
    endif()
  endforeach()
endforeach()
message(STATUS "ZIP/tar.gz create, move, extract and content comparisons passed")
